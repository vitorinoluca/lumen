import { Button, ProgressIndicator } from "std-widgets.slint";

export component Main inherits Window {
    title: "lumen";
    preferred-width: 900px;
    preferred-height: 600px;
    in property <float> cpu;
    in property <float> ram;
    in property <float> disk;
    in property <string> ram-text;
    in property <string> disk-text;
    in property <string> net-text;
    property <int> page: 0;
    property <[string]> pages: ["Monitor", "Procesos", "Inicio", "Disco", "Seguridad"];

    HorizontalLayout {
        Rectangle {
            width: 160px;
            background: #1e1e24;
            VerticalLayout {
                padding: 8px;
                spacing: 4px;
                alignment: start;
                for name[i] in pages: Button {
                    text: name;
                    primary: i == page;
                    clicked => { page = i; }
                }
            }
        }
        if page == 0: VerticalLayout {
            padding: 24px;
            spacing: 6px;
            alignment: start;
            Text { text: "CPU  \{Math.round(cpu * 100)}%"; font-size: 16px; }
            ProgressIndicator { progress: cpu; }
            Text { text: "RAM  " + ram-text; font-size: 16px; }
            ProgressIndicator { progress: ram; }
            Text { text: "Disco  " + disk-text; font-size: 16px; }
            ProgressIndicator { progress: disk; }
            Text { text: "Red  " + net-text; font-size: 16px; }
        }
        if page != 0: Text {
            text: pages[page];
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: 24px;
        }
    }
}
