import { Palette } from "std-widgets.slint";

export struct Row { pid: int, name: string, cpu: string, mem: string, path: string }
export struct StartupRow { name: string, command: string, scope: string, enabled: bool }
export struct ServiceRow { title: string, desc: string, level: string, tag: string, enabled: bool, locked: bool }
export struct Hw { os: string, os-sub: string, cpu: string, cpu-sub: string, ram: string, gpu: string, gpu-sub: string, board: string, board-sub: string }
export struct SecRow { title: string, sub: string, icon: string, alert: bool }
export struct FindingRow { title: string, detail: string, decoded: string, severity: int, can-disable: bool, can-restore: bool }
export struct DiskCard { name: string, sub: string, fraction: float }
export struct AppRow { name: string, detail: string, size: string, icon: image, has-icon: bool, initial: string }
export struct DiskRow { name: string, size: string }

// Un solo acento, neutros que siguen al sistema (claro/oscuro). Tamaños: 12 / 14 / 22.
export global Theme {
    out property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <color> bg: dark ? #101012 : #f7f7f8;
    out property <color> side: dark ? #161618 : #eeeef0;
    out property <color> line: dark ? #26262a : #dcdce0;
    out property <color> text: dark ? #ececee : #1d1d1f;
    out property <color> muted: dark ? #9a9aa0 : #6b6b72;
    out property <color> card: dark ? #151517 : #ffffff;
    out property <color> hover: dark ? #1f1f23 : #e4e4e8;
    out property <color> accent: dark ? #4fb39d : #2a7a68;
    out property <color> danger: dark ? #e5736a : #b3261e;
    out property <length> radius: 4px;
}

// Botón plano: borde fino, sin relleno.
// Íconos de línea (viewbox 24x24), mismo trazo en todos.
component Icon inherits Path {
    in property <string> kind;
    in property <color> tint: Theme.muted;
    width: 16px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: tint;
    stroke-width: 1.7px;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands:
        kind == "home" ? "M3 11 L12 3 L21 11 M5 9.5 V20 H19 V9.5" :
        kind == "list" ? "M4 6 H20 M4 12 H20 M4 18 H13" :
        kind == "power" ? "M12 3 V12 M6.3 6.8 A8 8 0 1 0 17.7 6.8" :
        kind == "disk" ? "M4 14 H20 V19 H4 Z M4 14 L7 5 H17 L20 14 M16 16.5 H16.5" :
        kind == "sliders" ? "M4 7 H20 M4 12 H20 M4 17 H20 M9 5 V9 M15 10 V14 M8 15 V19" :
        kind == "bolt" ? "M13 3 L5 14 H12 L11 21 L19 10 H12 Z" :
        kind == "box" ? "M3 7 L12 3 L21 7 V17 L12 21 L3 17 Z M3 7 L12 11 L21 7 M12 11 V21" :
        kind == "chip" ? "M7 7 H17 V17 H7 Z M10 3 V7 M14 3 V7 M10 17 V21 M14 17 V21 M3 10 H7 M3 14 H7 M17 10 H21 M17 14 H21" :
        kind == "memory" ? "M3 8 H21 V16 H3 Z M7 8 V16 M11 8 V16 M15 8 V16 M6 19 V16 M18 19 V16" :
        kind == "monitor" ? "M3 5 H21 V15 H3 Z M9 19 H15 M12 15 V19" :
        kind == "board" ? "M4 4 H20 V20 H4 Z M8 8 H12 V12 H8 Z M15 8 V16 M8 16 H12" :
        kind == "windows" ? "M3 5 L11 4 V11 H3 Z M13 3.8 L21 3 V11 H13 Z M3 13 H11 V20 L3 19 Z M13 13 H21 V21 L13 20 Z" :
        kind == "gear" ? "M12 9 A3 3 0 1 0 12 15 A3 3 0 1 0 12 9 M12 3 V5 M12 19 V21 M3 12 H5 M19 12 H21 M5.6 5.6 L7 7 M17 17 L18.4 18.4 M5.6 18.4 L7 17 M17 7 L18.4 5.6" :
        kind == "search" ? "M11 4 A7 7 0 1 0 11 18 A7 7 0 1 0 11 4 M16 16 L21 21" :
        kind == "eye" ? "M2 12 C5 6 19 6 22 12 C19 18 5 18 2 12 Z M12 9.5 A2.5 2.5 0 1 0 12 14.5 A2.5 2.5 0 1 0 12 9.5" :
        "M12 3 L20 6 V12 C20 17 16 20 12 21 C8 20 4 17 4 12 V6 Z"; // escudo
}

component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> strong: false;
    // Acción destructiva: fondo rojo suave, un poco más marcado al pasar el mouse.
    in property <bool> danger: false;
    out property <bool> hovered: ta.has-hover;
    callback clicked;
    height: 28px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: danger ? Theme.danger.with-alpha(0.5) : (strong ? Theme.accent : Theme.line);
    background: danger ? Theme.danger.with-alpha(ta.has-hover ? 0.28 : 0.16) : (ta.has-hover ? Theme.hover : transparent);
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        Text { text: root.text; font-size: 12px; color: root.danger ? Theme.danger : (root.strong ? Theme.accent : Theme.text); vertical-alignment: center; }
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> locked: false;
    callback toggled(bool);
    opacity: locked ? 0.4 : 1.0;
    width: 30px;
    height: 16px;
    border-radius: 8px;
    background: checked ? Theme.accent : Theme.line;
    Rectangle {
        x: root.checked ? 16px : 2px;
        y: 2px;
        width: 12px;
        height: 12px;
        border-radius: 6px;
        background: white;
    }
    TouchArea { enabled: !root.locked; mouse-cursor: root.locked ? MouseCursor.default : MouseCursor.pointer; clicked => { root.checked = !root.checked; root.toggled(root.checked); } }
}

component Bar inherits Rectangle {
    in property <float> value;
    height: 4px;
    border-radius: 2px;
    background: Theme.line;
    Rectangle { x: 0; width: parent.width * Math.min(1, Math.max(0, root.value)); border-radius: 2px; background: Theme.accent; }
}

component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    callback clicked;
    height: 32px;
    border-radius: Theme.radius;
    background: active ? Theme.hover : (ta.has-hover ? Theme.hover.with-alpha(0.5) : transparent);
    Rectangle { x: 0; y: 8px; width: 2px; height: 16px; background: active ? Theme.accent : transparent; }
    Icon { x: 12px; y: 8px; kind: root.icon; tint: root.active ? Theme.accent : Theme.muted; }
    Text { x: 36px; text: root.text; font-size: 14px; color: Theme.text; vertical-alignment: center; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

component Head inherits VerticalLayout {
    in property <string> title;
    in property <string> sub;
    spacing: 2px;
    Text { text: title; font-size: 22px; color: Theme.text; }
    Text { text: sub; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
}


component Search inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback changed(string);
    height: 32px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : Theme.line;
    background: Theme.card;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Icon { kind: "search"; tint: Theme.muted; y: 8px; }
        Rectangle {
            horizontal-stretch: 1;
            if input.text == "": Text { text: root.placeholder; color: Theme.muted; font-size: 14px; vertical-alignment: center; }
            input := TextInput {
                width: parent.width;
                height: parent.height;
                font-size: 14px;
                color: Theme.text;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: Theme.accent.with-alpha(0.35);
                edited => { root.text = self.text; root.changed(self.text); }
            }
        }
    }
}

// Lista con scroll: rueda, y una barra mínima sin pista ni fondo que se agranda al pasar el mouse
// y se puede arrastrar. Deja 16 px a la derecha para que el contenido no quede debajo de la barra.
component Scroll inherits Rectangle {
    /// Alto total del contenido (filas x alto de fila). Explícito: calcularlo solo deja valores viejos.
    in property <length> content-h;
    clip: true;
    property <bool> can-scroll: content-h > fl.height;
    property <length> thumb-h: max(28px, fl.height * fl.height / max(1px, content-h));
    property <length> thumb-y: can-scroll ? -fl.content-y / max(1px, content-h - fl.height) * (fl.height - thumb-h) : 0px;
    property <bool> active: strip.has-hover || strip.pressed;

    function scroll-to(ty: length) {
        if (can-scroll) {
            fl.content-y = -(Math.clamp(ty, 0px, fl.height - thumb-h) / max(1px, fl.height - thumb-h)) * (content-h - fl.height);
        }
    }

    fl := Flickable {
        x: 0px;
        width: parent.width - 16px;
        height: parent.height;
        content-height: root.content-h;
        interactive: false;
        @children
    }
    strip := TouchArea {
        x: parent.width - 16px;
        width: 16px;
        height: parent.height;
        enabled: can-scroll;
        property <length> grab;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                if (self.mouse-y >= thumb-y && self.mouse-y <= thumb-y + thumb-h) {
                    grab = self.mouse-y - thumb-y;
                } else {
                    grab = thumb-h / 2;
                    scroll-to(self.mouse-y - grab);
                }
            }
        }
        moved => {
            if (self.pressed) {
                scroll-to(self.mouse-y - grab);
            }
        }
        scroll-event(e) => {
            fl.content-y = Math.clamp(fl.content-y + e.delta-y, -max(0px, content-h - fl.height), 0px);
            EventResult.accept
        }
    }
    Rectangle {
        visible: can-scroll;
        width: active ? 8px : 3px;
        x: parent.width - self.width - 4px;
        y: thumb-y;
        height: thumb-h;
        border-radius: self.width / 2;
        background: Theme.muted.with-alpha(active ? 0.85 : 0.5);
        animate width { duration: 90ms; }
    }
}

// Diálogo de confirmación centrado, con el resto de la ventana atenuado.
component Confirm inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> ok-text;
    in property <bool> danger: false;
    callback ok();
    callback cancel();
    background: Theme.dark ? #000000a0 : #00000060;
    TouchArea { }  // evita que los clics lleguen a lo que está debajo
    Rectangle {
        width: min(420px, parent.width - 48px);
        height: box.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.card;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 8px;
        box := VerticalLayout {
            padding: 20px;
            spacing: 8px;
            Text { text: root.title; font-size: 14px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
            Text { text: root.body; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
            Rectangle { height: 8px; }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Btn { text: "Cancelar"; clicked => { root.cancel(); } }
                Btn { text: root.ok-text; strong: !root.danger; danger: root.danger; clicked => { root.ok(); } }
            }
        }
    }
}

// Hallazgo de la revisión de comportamiento: severidad, qué es, y las acciones (siempre con confirmación).
component FindingCard inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <string> decoded;
    in property <int> severity;
    in property <bool> can-disable;
    in property <bool> can-restore;
    callback ignore();
    callback disable();
    callback restore();
    background: Theme.card;
    border-width: 1px;
    border-color: severity == 0 ? Theme.danger.with-alpha(0.55) : Theme.line;
    border-radius: 6px;
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                height: 20px;
                width: chip.preferred-width + 16px;
                border-radius: 3px;
                border-width: 1px;
                border-color: severity == 0 ? Theme.danger : (severity == 1 ? Theme.text : Theme.line);
                chip := Text {
                    text: severity == 0 ? "Alta" : (severity == 1 ? "Media" : "Baja");
                    font-size: 12px;
                    color: severity == 0 ? Theme.danger : (severity == 1 ? Theme.text : Theme.muted);
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text { text: root.title; font-size: 14px; color: Theme.text; wrap: word-wrap; horizontal-stretch: 1; }
        }
        Text { text: root.detail; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
        if root.decoded != "": Rectangle {
            background: Theme.bg;
            border-radius: Theme.radius;
            VerticalLayout {
                padding: 8px;
                spacing: 4px;
                Text { text: "Comando real (estaba codificado):"; font-size: 12px; color: Theme.muted; }
                Text { text: root.decoded; font-size: 12px; color: Theme.text; wrap: word-wrap; }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Btn { text: "Ignorar"; clicked => { root.ignore(); } }
            if root.can-disable: Btn { text: "Deshabilitar"; danger: true; clicked => { root.disable(); } }
            if root.can-restore: Btn { text: "Restaurar"; strong: true; clicked => { root.restore(); } }
        }
    }
}

// Botón circular de la revisión: grande y centrado al principio, chico cuando ya hay resultados.
component ScanButton inherits Rectangle {
    in property <length> size: 220px;
    in property <bool> busy: false;
    in property <bool> compact: false;
    callback clicked;
    width: size;
    height: size;
    border-radius: size / 2;
    border-width: compact ? 2px : 3px;
    border-color: Theme.accent;
    background: busy ? Theme.card : (ta.has-hover ? Theme.accent.with-alpha(0.14) : Theme.card);
    // Arco que gira mientras se analiza, para saber que sigue trabajando.
    Path {
        visible: root.busy;
        width: root.size - 12px;
        height: root.size - 12px;
        x: 6px;
        y: 6px;
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 50 2 A 48 48 0 0 1 98 50";
        stroke: Theme.accent;
        stroke-width: 4px;
        stroke-line-cap: round;
        transform-rotation: root.busy ? 360deg : 0deg;
        animate transform-rotation { duration: 1.2s; iteration-count: -1; easing: linear; }
    }
    Text {
        text: root.busy ? "Analizando…" : "Analizar";
        font-size: root.compact ? 12px : 28px;
        font-weight: 600;
        color: Theme.accent;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    ta := TouchArea { mouse-cursor: root.busy ? MouseCursor.default : MouseCursor.pointer; clicked => { root.clicked(); } }
}

component Sep inherits Rectangle {
    height: 13px;
    Rectangle { y: 6px; height: 1px; background: Theme.line; }
}

// Etiqueta de riesgo: el acento es para "seguro", rojo solo para lo bloqueado.
component Badge inherits Rectangle {
    in property <string> level;
    height: 20px;
    border-radius: 3px;
    border-width: 1px;
    border-color: level == "seguro" ? Theme.accent : (level == "bloqueado" ? Theme.danger : Theme.line);
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        Text {
            text: level == "seguro" ? "Seguro" : (level == "bloqueado" ? "Bloqueado" : "Depende");
            font-size: 12px;
            vertical-alignment: center;
            color: level == "seguro" ? Theme.accent : (level == "bloqueado" ? Theme.danger : Theme.muted);
        }
    }
}

component Card inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    in property <string> level;
    in property <string> tag;
    in property <bool> checked;
    in property <bool> locked;
    callback toggled(bool);
    background: Theme.card;
    border-width: 1px;
    border-color: Theme.line;
    border-radius: 6px;
    VerticalLayout {
        padding: 14px;
        spacing: 6px;
        HorizontalLayout {
            spacing: 8px;
            Text { text: title; font-size: 14px; color: Theme.text; overflow: elide; horizontal-stretch: 1; }
            if tag != "": Text { text: tag; font-size: 12px; color: Theme.muted; }
        }
        Text { text: desc; font-size: 12px; color: Theme.muted; wrap: word-wrap; overflow: elide; vertical-stretch: 1; }
        HorizontalLayout {
            if level != "": Badge { level: root.level; }
            Rectangle { horizontal-stretch: 1; }
            Toggle { checked: root.checked; locked: root.locked; toggled(on) => { root.toggled(on); } }
        }
    }
}

// Tarjetas en dos columnas, con scroll.
component CardGrid inherits Rectangle {
    in property <[ServiceRow]> items;
    callback toggled(int, bool);
    Scroll {
        content-h: Math.ceil(items.length / 2) * 150px;
        Rectangle {
            height: Math.ceil(items.length / 2) * 150px;
            for e[i] in items: Card {
                x: Math.mod(i, 2) * (parent.width / 2);
                y: Math.floor(i / 2) * 150px;
                width: parent.width / 2 - 8px;
                height: 140px;
                title: e.title;
                desc: e.desc;
                level: e.level;
                tag: e.tag;
                checked: e.enabled;
                locked: e.locked;
                toggled(on) => { root.toggled(i, on); }
            }
        }
    }
}

component Tabs inherits HorizontalLayout {
    in property <[string]> items;
    in property <int> current;
    callback picked(int);
    spacing: 20px;
    alignment: start;
    for t[i] in items: Rectangle {
        width: label.preferred-width;
        height: 30px;
        label := Text { text: t; font-size: 14px; color: i == current ? Theme.text : Theme.muted; vertical-alignment: center; }
        Rectangle { y: parent.height - 2px; height: 2px; background: i == current ? Theme.accent : transparent; }
        TouchArea { mouse-cursor: pointer; clicked => { root.picked(i); } }
    }
}

// Tarjeta de datos del equipo: ícono, título, detalle y barra opcional.
component Info inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> sub;
    in property <float> fraction: -1;
    in property <bool> alert: false;
    background: Theme.card;
    border-width: 1px;
    border-color: alert ? Theme.danger.with-alpha(0.55) : Theme.line;
    border-radius: 6px;
    min-height: 68px;
    HorizontalLayout {
        padding: 14px;
        spacing: 12px;
        Icon { kind: root.icon; tint: root.alert ? Theme.danger : Theme.muted; y: 2px; width: 20px; height: 20px; }
        VerticalLayout {
            spacing: 3px;
            alignment: center;
            Text { text: title; font-size: 14px; color: Theme.text; overflow: elide; }
            Text { text: sub; font-size: 12px; color: Theme.muted; overflow: elide; }
            if fraction >= 0: Bar { value: fraction; }
        }
    }
}

export component Main inherits Window {
    title: "lumen";
    icon: @image-url("../assets/icon.png");
    preferred-width: 920px;
    preferred-height: 620px;
    min-width: 640px;
    min-height: 420px;
    background: Theme.bg;
    default-font-family: "Segoe UI";

    in property <float> cpu;
    in property <float> ram;
    in property <float> disk;
    in property <string> ram-text;
    in property <string> disk-text;
    in property <string> net-text;
    in property <[Row]> procs;
    in property <[StartupRow]> startup;
    in property <[ServiceRow]> privacy;
    in property <[ServiceRow]> services;
    in property <[ServiceRow]> profiles;
    in property <Hw> hw;
    in property <[DiskCard]> disks;
    in property <[SecRow]> sec-cards;
    in property <[SecRow]> threats;
    in property <[FindingRow]> findings;
    in property <length> findings-h;
    in-out property <bool> behavior-run;
    in-out property <bool> behavior-busy;
    in-out property <int> sec-confirm: -1;
    in-out property <int> sec-confirm-action;
    in-out property <string> sec-status;
    in property <[AppRow]> apps;
    in property <[DiskRow]> leftovers;
    in-out property <bool> can-undo-leftovers;
    in-out property <string> apps-sort-label: "nombre";
    in-out property <int> confirm-app: -1;
    in-out property <string> confirm-app-name;
    in-out property <string> status;
    in property <[DiskRow]> targets;
    in property <[DiskRow]> space-map;
    in property <string> stash-text;
    in-out property <string> disk-status;
    in-out property <bool> confirm-purge;
    in-out property <int> page: 0;
    // pid pendiente de confirmar para cerrar (-1 = ninguno)
    in-out property <int> kill-pid: -1;
    in-out property <string> kill-name;
    in-out property <string> sort-label: "uso de CPU";
    property <[string]> pages: ["Panel", "Procesos", "Arranque", "Disco", "Privacidad", "Servicios", "Perfiles", "Programas", "Seguridad", "Configuración"];

    callback sort(int);
    callback kill(int);
    callback opened();
    callback toggle-startup(int, bool);
    callback toggle-privacy(int, bool);
    callback toggle-service(int, bool);
    callback toggle-profile(int, bool);
    callback uninstall(int);
    callback scan-behavior();
    callback behavior-ready();
    callback finding-do(int, int);
    callback apps-reload();
    callback apps-rebuild();
    callback apps-filter(string);
    callback apps-sort(int);
    callback clean-leftovers();
    callback undo-leftovers();
    callback dismiss-leftovers();
    callback disable-service(int, string);
    callback clean(int);
    callback undo-clean();
    callback purge();
    callback scan-map();
    changed page => { opened(); }

    HorizontalLayout {
        Rectangle {
            width: 168px;
            background: Theme.side;
            Rectangle { x: parent.width - 1px; width: 1px; background: Theme.line; }
            VerticalLayout {
                padding: 12px;
                spacing: 2px;
                VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 2px;
                    alignment: start;
                    Text { text: "lumen"; font-size: 14px; font-weight: 600; color: Theme.text; }
                    Rectangle { height: 12px; }
                    NavItem { text: "Panel"; icon: "home"; active: page == 0; clicked => { page = 0; } }
                    NavItem { text: "Optimizar"; icon: "bolt"; active: page >= 4 && page <= 6; clicked => { status = ""; page = 4; } }
                    NavItem { text: "Programas"; icon: "box"; active: page == 7; clicked => { page = 7; } }
                    Sep { }
                    NavItem { text: "Gestor de inicio"; icon: "power"; active: page == 2; clicked => { page = 2; } }
                    NavItem { text: "Procesos"; icon: "list"; active: page == 1; clicked => { page = 1; } }
                    NavItem { text: "Limpieza de disco"; icon: "disk"; active: page == 3; clicked => { page = 3; } }
                    Sep { }
                    NavItem { text: "Seguridad"; icon: "shield"; active: page == 8; clicked => { page = 8; } }
                }
                NavItem { text: "Configuración"; icon: "gear"; active: page == 9; clicked => { page = 9; } }
            }
        }

        if page == 0: VerticalLayout {
            padding: 24px;
            spacing: 12px;
            alignment: start;
            Head { title: "Panel"; sub: "Resumen de tu equipo. Se actualiza cada segundo."; }
            HorizontalLayout {
                spacing: 12px;
                Info { icon: "windows"; title: hw.os; sub: hw.os-sub; }
                Info { icon: "chip"; title: hw.cpu; sub: "\{Math.round(cpu * 100)} % en uso · " + hw.cpu-sub; fraction: cpu; }
            }
            HorizontalLayout {
                spacing: 12px;
                Info { icon: "memory"; title: hw.ram; sub: ram-text + " en uso"; fraction: ram; }
                Info { icon: "monitor"; title: hw.gpu; sub: hw.gpu-sub; }
            }
            Info { icon: "board"; title: hw.board; sub: hw.board-sub + " · Red: " + net-text; }
            Text { text: "Almacenamiento"; font-size: 12px; color: Theme.muted; }
            for d in disks: Info { icon: "disk"; title: d.name; sub: d.sub; fraction: d.fraction; }
        }

        if page == 1: VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Head { title: "\{procs.length} procesos"; sub: "Ordenados por " + sort-label + "."; }
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Btn { text: "Por CPU"; clicked => { sort-label = "uso de CPU"; sort(0); } }
                Btn { text: "Por memoria"; clicked => { sort-label = "memoria"; sort(1); } }
                Btn { text: "Por nombre"; clicked => { sort-label = "nombre"; sort(2); } }
            }
            Scroll {
                content-h: procs.length * 28px;
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                for p in procs: Rectangle {
                    height: 28px;
                    background: (ta.has-hover || close-btn.hovered) ? Theme.hover : transparent;
                    ta := TouchArea { }
                    HorizontalLayout {
                        spacing: 12px;
                        padding-left: 4px;
                        padding-right: 10px;
                        Text { text: p.name; width: 190px; font-size: 14px; color: Theme.text; overflow: elide; vertical-alignment: center; }
                        Text { text: p.cpu; width: 44px; font-size: 14px; color: Theme.text; horizontal-alignment: right; vertical-alignment: center; }
                        Text { text: p.mem; width: 76px; font-size: 14px; color: Theme.text; horizontal-alignment: right; vertical-alignment: center; }
                        Text { text: p.path; font-size: 12px; color: Theme.muted; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                        VerticalLayout { alignment: center; close-btn := Btn { text: "Cerrar"; danger: true; height: 22px; visible: ta.has-hover || close-btn.hovered; clicked => { kill-name = p.name; kill-pid = p.pid; } } }
                    }
                }
            }
            }
        }

        if page == 2: VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Head { title: "\{startup.length} apps arrancan con Windows"; sub: "Desactivarlas no las borra. Podés volver a activarlas cuando quieras."; }
            if status != "": Text { text: status; font-size: 12px; color: Theme.danger; }
            Scroll {
                content-h: startup.length * 36px;
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                for e[i] in startup: Rectangle {
                    height: 36px;
                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                    HorizontalLayout {
                        spacing: 12px;
                        padding-left: 4px;
                        Toggle { y: 10px; checked: e.enabled; toggled(on) => { toggle-startup(i, on); } }
                        Text { text: e.name; width: 190px; font-size: 14px; color: Theme.text; overflow: elide; vertical-alignment: center; }
                        Text { text: e.scope; width: 56px; font-size: 12px; color: Theme.muted; vertical-alignment: center; }
                        Text { text: e.command; font-size: 12px; color: Theme.muted; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                    }
                }
            }
            }
        }

        if page == 3: VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Head { title: "Disco"; sub: "Limpiar mueve los archivos a una reserva. Se pueden devolver hasta que la vacíes."; }
            if disk-status != "": Text { text: disk-status; font-size: 12px; color: Theme.muted; }
            for t[i] in targets: Rectangle {
                height: 36px;
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                HorizontalLayout {
                    spacing: 12px;
                    Text { text: t.name; horizontal-stretch: 1; font-size: 14px; color: Theme.text; vertical-alignment: center; }
                    Text { text: t.size; width: 80px; font-size: 14px; color: Theme.text; horizontal-alignment: right; vertical-alignment: center; }
                    VerticalLayout { alignment: center; Btn { text: "Limpiar"; clicked => { clean(i); } } }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "En reserva: " + stash-text; font-size: 12px; color: Theme.muted; vertical-alignment: center; horizontal-stretch: 1; }
                Btn { text: "Deshacer última limpieza"; clicked => { undo-clean(); } }
                if !confirm-purge: Btn { text: "Vaciar reserva"; clicked => { confirm-purge = true; } }
                if confirm-purge: Btn { text: "Confirmar: no se puede deshacer"; strong: true; clicked => { confirm-purge = false; purge(); } }
            }
            Rectangle { height: 8px; }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Qué ocupa más en tu usuario"; font-size: 14px; color: Theme.text; vertical-alignment: center; horizontal-stretch: 1; }
                Btn { text: "Analizar"; clicked => { scan-map(); } }
            }
            Scroll {
                content-h: space-map.length * 24px;
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                for m in space-map: HorizontalLayout {
                    spacing: 12px;
                    height: 24px;
                    Text { text: m.size; width: 80px; font-size: 12px; color: Theme.text; horizontal-alignment: right; vertical-alignment: center; }
                    Text { text: m.name; font-size: 12px; color: Theme.muted; overflow: elide; vertical-alignment: center; }
                }
            }
            }
        }

        if page >= 4 && page <= 6: VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Head {
                title: "Optimizar";
                sub: page == 4 ? "Apagá lo que Windows comparte o muestra de más. Cada ajuste se puede volver atrás."
                   : (page == 5 ? "Programas que Windows corre por detrás. Desactivar necesita administrador y rige desde el próximo arranque."
                   : "Cambian el plan de energía de Windows. Al apagarlos vuelve el plan anterior.");
            }
            Tabs { items: ["Privacidad", "Servicios", "Perfiles"]; current: page - 4; picked(i) => { status = ""; page = 4 + i; } }
            if status != "": Text { text: status; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
            if page == 4: CardGrid { items: privacy; toggled(i, on) => { toggle-privacy(i, on); } }
            if page == 5: CardGrid { items: services; toggled(i, on) => { toggle-service(i, on); } }
            if page == 6: CardGrid { items: profiles; toggled(i, on) => { toggle-profile(i, on); } }
        }

        if page == 7: VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Head { title: "\{apps.length} programas"; sub: "Abre el desinstalador de cada programa y después te muestra lo que quedó. Orden: " + apps-sort-label + "."; }
            HorizontalLayout {
                spacing: 8px;
                Search { placeholder: "Buscar programa o editor"; changed(t) => { apps-filter(t); } horizontal-stretch: 1; }
                Btn { text: "Nombre"; clicked => { apps-sort(0); } }
                Btn { text: "Peso"; clicked => { apps-sort(1); } }
                Btn { text: "Editor"; clicked => { apps-sort(2); } }
            }
            if status != "": Text { text: status; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
            if leftovers.length > 0: VerticalLayout {
                spacing: 6px;
                Text { text: "Quedaron \{leftovers.length} restos. Revisalos antes de limpiar:"; font-size: 14px; color: Theme.text; }
                for l in leftovers: HorizontalLayout {
                    spacing: 12px;
                    Text { text: l.size; width: 64px; font-size: 12px; color: Theme.muted; }
                    Text { text: l.name; font-size: 12px; color: Theme.text; overflow: elide; horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    Btn { text: "Mover a la reserva"; strong: true; clicked => { clean-leftovers(); } }
                    Btn { text: "Dejarlos"; clicked => { dismiss-leftovers(); } }
                }
            }
            if can-undo-leftovers: Btn { text: "Deshacer limpieza de restos"; clicked => { undo-leftovers(); } }
            Scroll {
                content-h: apps.length * 40px;
                vertical-stretch: 1;
                VerticalLayout {
                    alignment: start;
                for a[i] in apps: Rectangle {
                    height: 40px;
                    background: (app-ta.has-hover || un-btn.hovered) ? Theme.hover : transparent;
                    app-ta := TouchArea { }
                    HorizontalLayout {
                        spacing: 12px;
                        padding-left: 4px;
                        padding-right: 10px;
                        Rectangle {
                            width: 28px;
                            if a.has-icon: Image { source: a.icon; width: 24px; height: 24px; y: (parent.height - 24px) / 2; image-fit: contain; }
                            if !a.has-icon: Rectangle {
                                width: 24px;
                                height: 24px;
                                y: (parent.height - 24px) / 2;
                                border-radius: Theme.radius;
                                background: Theme.hover;
                                Text { text: a.initial; font-size: 12px; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            Text { text: a.name; font-size: 14px; color: Theme.text; overflow: elide; }
                            Text { text: a.detail; font-size: 12px; color: Theme.muted; overflow: elide; }
                        }
                        Text { text: a.size; width: 70px; font-size: 12px; color: Theme.muted; horizontal-alignment: right; vertical-alignment: center; }
                        VerticalLayout { alignment: center; un-btn := Btn { text: "Desinstalar"; danger: true; height: 24px; visible: app-ta.has-hover || un-btn.hovered; clicked => { confirm-app-name = a.name; confirm-app = i; } } }
                    }
                }
            }
            }
        }

        if page == 8: VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Head { title: "Seguridad"; sub: "Revisa Windows Defender, lo que arranca solo, las conexiones, los procesos y los drivers. No reemplaza a un antivirus."; }

            // Antes del primer análisis: solo el botón, grande y en el centro.
            if !behavior-run: VerticalLayout {
                vertical-stretch: 1;
                alignment: center;
                spacing: 20px;
                HorizontalLayout {
                    alignment: center;
                    ScanButton { size: 220px; busy: behavior-busy; clicked => { if (!behavior-busy) { scan-behavior(); } } }
                }
                Text {
                    text: behavior-busy ? sec-status : "Toca para revisar tu PC. Tarda unos segundos.";
                    font-size: 12px;
                    color: Theme.muted;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
            }

            // Después: el botón se achica arriba y aparecen los resultados.
            if behavior-run: VerticalLayout {
                vertical-stretch: 1;
                spacing: 12px;
                HorizontalLayout {
                    spacing: 16px;
                    ScanButton { size: 88px; compact: true; busy: behavior-busy; clicked => { if (!behavior-busy) { scan-behavior(); } } }
                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text {
                            text: behavior-busy ? "Analizando…" : (findings.length == 0 ? "No encontré nada nuevo ni sospechoso en esta revisión. Eso no garantiza que la PC esté limpia." : (findings.length == 1 ? "Encontré 1 cosa para revisar" : "Encontré \{findings.length} cosas para revisar"));
                            font-size: 14px;
                            color: Theme.text;
                            wrap: word-wrap;
                        }
                        if sec-status != "": Text { text: sec-status; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                    }
                }
                Scroll {
                    vertical-stretch: 1;
                    content-h: sec-cards.length * 80px + (threats.length > 0 ? 40px : 0px) + threats.length * 96px + findings-h;
                    VerticalLayout {
                        alignment: start;
                        spacing: 12px;
                        for f[i] in findings: FindingCard {
                            title: f.title;
                            detail: f.detail;
                            decoded: f.decoded;
                            severity: f.severity;
                            can-disable: f.can-disable;
                            can-restore: f.can-restore;
                            ignore => { sec-confirm-action = 1; sec-confirm = i; }
                            disable => { sec-confirm-action = 2; sec-confirm = i; }
                            restore => { sec-confirm-action = 3; sec-confirm = i; }
                        }
                        for c in sec-cards: Info { icon: c.icon; title: c.title; sub: c.sub; }
                        if threats.length > 0: Text { text: "Detecciones registradas por Defender (\{threats.length})"; font-size: 14px; color: Theme.text; }
                        for t in threats: Info { icon: t.icon; title: t.title; sub: t.sub; alert: t.alert; }
                    }
                }
            }
        }

        if page > 8: VerticalLayout {
            padding: 24px;
            alignment: start;
            Head { title: pages[page]; sub: "Todavía no está disponible."; }
        }
    }

    if confirm-app >= 0: Confirm {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        title: "¿Desinstalar \{confirm-app-name}?";
        body: "Se abre el desinstalador del programa. Cuando termine, te mostramos lo que haya quedado para que decidas si lo limpiás. Si lumen corre como administrador, antes se crea un punto de restauración.";
        ok-text: "Desinstalar";
        danger: true;
        ok => { uninstall(confirm-app); confirm-app = -1; }
        cancel => { confirm-app = -1; }
    }
    if kill-pid >= 0: Confirm {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        title: "¿Cerrar \{kill-name}?";
        body: "Perdés lo que no hayas guardado en ese programa. No se puede deshacer.";
        ok-text: "Cerrar proceso";
        danger: true;
        ok => { kill(kill-pid); kill-pid = -1; }
        cancel => { kill-pid = -1; }
    }
    if sec-confirm >= 0: Confirm {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        title: sec-confirm-action == 1 ? "¿Ignorar este hallazgo?" : (sec-confirm-action == 2 ? "¿Deshabilitar esto?" : "¿Restaurar lo que deshabilitó lumen?");
        body: sec-confirm-action == 1 ? "Se agrega a la línea base y no se vuelve a mostrar. No cambia nada en tu PC."
            : (sec-confirm-action == 2 ? "Se desactiva y antes se guarda un respaldo. Podés volver atrás con Restaurar. Algunos cambios necesitan abrir lumen como administrador."
            : "Se vuelve a dejar como estaba antes de que lumen lo deshabilitara.");
        ok-text: sec-confirm-action == 1 ? "Ignorar" : (sec-confirm-action == 2 ? "Deshabilitar" : "Restaurar");
        danger: sec-confirm-action == 2;
        ok => { finding-do(sec-confirm, sec-confirm-action); sec-confirm = -1; }
        cancel => { sec-confirm = -1; }
    }
}
