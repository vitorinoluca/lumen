import { Button, ProgressIndicator, ListView, Switch } from "std-widgets.slint";

export struct Row { pid: int, name: string, cpu: string, mem: string, path: string }

export struct StartupRow { name: string, command: string, scope: string, enabled: bool }

export struct DiskRow { name: string, size: string }

export component Main inherits Window {
    title: "lumen";
    preferred-width: 900px;
    preferred-height: 600px;

    in property <float> cpu;
    in property <float> ram;
    in property <float> disk;
    in property <string> ram-text;
    in property <string> disk-text;
    in property <string> net-text;
    in property <[Row]> procs;
    in property <[StartupRow]> startup;
    in-out property <string> status;
    in property <[DiskRow]> targets;
    in property <[DiskRow]> space-map;
    in property <string> stash-text;
    in-out property <string> disk-status;
    in-out property <bool> confirm-purge;
    in-out property <int> page: 0;
    // pid pendiente de confirmar para finalizar (-1 = ninguno)
    in-out property <int> kill-pid: -1;
    in-out property <string> kill-name;
    property <[string]> pages: ["Monitor", "Procesos", "Inicio", "Disco", "Seguridad"];

    callback sort(int);
    callback kill(int);
    callback opened();
    callback clean(int);
    callback undo-clean();
    callback purge();
    callback scan-map();
    callback toggle-startup(int, bool);
    changed page => { opened(); }

    HorizontalLayout {
        Rectangle {
            width: 160px;
            background: #1e1e24;
            VerticalLayout {
                padding: 8px;
                spacing: 4px;
                alignment: start;
                for name[i] in pages: Button {
                    text: name;
                    primary: i == page;
                    clicked => { page = i; }
                }
            }
        }
        if page == 0: VerticalLayout {
            padding: 24px;
            spacing: 6px;
            alignment: start;
            Text { text: "CPU  \{Math.round(cpu * 100)}%"; font-size: 16px; }
            ProgressIndicator { progress: cpu; }
            Text { text: "RAM  " + ram-text; font-size: 16px; }
            ProgressIndicator { progress: ram; }
            Text { text: "Disco  " + disk-text; font-size: 16px; }
            ProgressIndicator { progress: disk; }
            Text { text: "Red  " + net-text; font-size: 16px; }
        }
        if page == 1: VerticalLayout {
            padding: 12px;
            spacing: 6px;
            HorizontalLayout {
                spacing: 6px;
                Text { text: "Ordenar por:"; vertical-alignment: center; }
                Button { text: "CPU"; clicked => { sort(0); } }
                Button { text: "Memoria"; clicked => { sort(1); } }
                Button { text: "Nombre"; clicked => { sort(2); } }
            }
            if kill-pid >= 0: Rectangle {
                background: #5a2a2a;
                height: 40px;
                HorizontalLayout {
                    padding: 6px;
                    spacing: 8px;
                    Text { text: "¿Finalizar \{kill-name}? No se puede deshacer."; vertical-alignment: center; color: white; }
                    Button { text: "Finalizar"; clicked => { kill(kill-pid); kill-pid = -1; } }
                    Button { text: "Cancelar"; clicked => { kill-pid = -1; } }
                }
            }
            ListView {
                for p in procs: Rectangle {
                    height: 26px;
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: p.name; width: 180px; overflow: elide; vertical-alignment: center; }
                        Text { text: p.cpu; width: 50px; horizontal-alignment: right; vertical-alignment: center; }
                        Text { text: p.mem; width: 80px; horizontal-alignment: right; vertical-alignment: center; }
                        Text { text: p.path; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; color: #888; }
                        Button { text: "×"; width: 28px; clicked => { kill-name = p.name; kill-pid = p.pid; } }
                    }
                }
            }
        }
        if page == 2: VerticalLayout {
            padding: 12px;
            spacing: 6px;
            Text { text: status; color: #c9a227; }
            ListView {
                for e[i] in startup: Rectangle {
                    height: 34px;
                    HorizontalLayout {
                        spacing: 8px;
                        Switch { checked: e.enabled; toggled => { toggle-startup(i, self.checked); } }
                        Text { text: e.name; width: 160px; overflow: elide; vertical-alignment: center; }
                        Text { text: e.scope; width: 70px; vertical-alignment: center; color: #888; }
                        Text { text: e.command; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; color: #888; }
                    }
                }
            }
        }
        if page == 3: VerticalLayout {
            padding: 12px;
            spacing: 6px;
            Text { text: "Limpieza (se mueve a una reserva, se puede deshacer)"; font-size: 16px; }
            Text { text: disk-status; color: #c9a227; }
            for t[i] in targets: HorizontalLayout {
                spacing: 8px;
                Text { text: t.name; width: 200px; vertical-alignment: center; }
                Text { text: t.size; width: 90px; horizontal-alignment: right; vertical-alignment: center; }
                Button { text: "Limpiar"; clicked => { clean(i); } }
            }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "En reserva: " + stash-text; vertical-alignment: center; }
                Button { text: "Deshacer última limpieza"; clicked => { undo-clean(); } }
                if !confirm-purge: Button { text: "Vaciar reserva"; clicked => { confirm-purge = true; } }
                if confirm-purge: Button { text: "¿Seguro? No se puede deshacer"; primary: true; clicked => { confirm-purge = false; purge(); } }
            }
            Rectangle { height: 8px; }
            HorizontalLayout {
                spacing: 8px;
                Text { text: "Espacio por carpeta (tu usuario)"; font-size: 16px; vertical-alignment: center; }
                Button { text: "Analizar"; clicked => { scan-map(); } }
            }
            ListView {
                for m in space-map: HorizontalLayout {
                    spacing: 8px;
                    Text { text: m.size; width: 90px; horizontal-alignment: right; }
                    Text { text: m.name; overflow: elide; }
                }
            }
        }
        if page > 3: Text {
            text: pages[page];
            horizontal-alignment: center;
            vertical-alignment: center;
            font-size: 24px;
        }
    }
}
