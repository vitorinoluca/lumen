import { Palette } from "std-widgets.slint";

export struct Row { pid: int, name: string, cpu: string, mem: string, path: string, icon: image, has-icon: bool, initial: string }
export struct StartupRow { name: string, command: string, scope: string, enabled: bool, icon: image, has-icon: bool, initial: string }
export struct ServiceRow { title: string, desc: string, level: string, tag: string, enabled: bool, locked: bool }
export struct Hw { os: string, os-sub: string, cpu: string, cpu-sub: string, ram: string, gpu: string, gpu-sub: string, board: string, board-sub: string }
export struct SecRow { title: string, sub: string, icon: string, alert: bool }
export struct FindingRow { title: string, detail: string, decoded: string, severity: int, can-disable: bool, can-restore: bool }
export struct OptRow { header: bool, title: string, desc: string, tag: string, enabled: bool, locked: bool, kind: int, src: int, icon: string, col: int, y: float }
export struct DiskCard { name: string, sub: string, fraction: float }
export struct AppRow { name: string, detail: string, size: string, icon: image, has-icon: bool, initial: string }
export struct DiskRow { name: string, size: string }
export struct DupRow { name: string, folder: string, copies: int, wasted: string }
export struct SpaceRow { name: string, size: string, fraction: float }
export struct CleanRow { name: string, desc: string, size: string }
// Una opción de sección: `idx` apunta a la lista que guarda Rust. risk: 0 = seguro (verde), 1 = revisar (amarillo).
export struct OptionRow { idx: int, title: string, desc: string, risk: int, checked: bool, done: bool, group: int, header: bool, icon: image, has-icon: bool }
// Lo que se va a hacer, antes de aplicar.
export struct PreviewRow { title: string, detail: string, undoable: bool }
// Un cambio del historial.
export struct HistRow { id: int, title: string, detail: string, applied: bool, undoable: bool }

// Lo que se ve es el material de Windows (Mica) a través de la ventana: nada de fondos sólidos.
// Las superficies son capas translúcidas (blanco o negro con poca opacidad) y el texto, el mismo color con alfa.
// Un solo acento. Tamaños: 12 / 14 / 28 (títulos) / 32 (cifras).
export global Theme {
    // 0 = como Windows, 1 = claro, 2 = oscuro
    in-out property <int> mode: 0;
    // Sin Mica (Windows 10 o 11 viejo) la ventana no puede ser transparente: se pinta un fondo sólido.
    in-out property <bool> solid: false;
    out property <bool> dark: mode == 2 || (mode == 0 && Palette.color-scheme == ColorScheme.dark);
    out property <color> text: dark ? #f5f5f7 : #1a1a1c;
    out property <color> muted: dark ? #ffffff9e : #0000009e;
    out property <color> faint: dark ? #ffffff5c : #00000066;
    // La hoja donde vive el contenido, y las piezas que se apoyan encima.
    out property <color> sheet: dark ? #ffffff0a : #ffffff80;
    out property <color> raised: dark ? #ffffff0f : #ffffffb3;
    out property <color> hover: dark ? #ffffff14 : #0000000b;
    out property <color> pressed: dark ? #ffffff1f : #00000014;
    out property <color> chosen: dark ? #ffffff24 : #ffffffe6;
    out property <color> line: dark ? #ffffff17 : #0000001a;
    out property <color> accent: dark ? #62c9b2 : #1d7a65;
    out property <color> on-accent: dark ? #04211b : #ffffff;
    out property <color> good: dark ? #6fd69f : #1a7f4b;
    out property <color> warn: dark ? #f2c35c : #9a6700;
    out property <color> danger: dark ? #ff8f85 : #c42b1c;
    // Lo único opaco: los diálogos, para que el texto se lea siempre.
    out property <color> pop: dark ? #2a2a2e : #fbfbfb;
    out property <color> backdrop: dark ? #1c1c1f : #f3f3f5;
    out property <length> radius: 6px;
}

// Íconos de línea (viewbox 24x24), mismo trazo en todos.
component Icon inherits Path {
    in property <string> kind;
    in property <color> tint: Theme.muted;
    width: 16px;
    height: 16px;
    viewbox-width: 24;
    viewbox-height: 24;
    stroke: tint;
    stroke-width: 1.6px;
    stroke-line-cap: round;
    stroke-line-join: round;
    commands:
        kind == "home" ? "M3 11 L12 3 L21 11 M5 9.5 V20 H19 V9.5" :
        kind == "list" ? "M4 6 H20 M4 12 H20 M4 18 H13" :
        kind == "power" ? "M12 3 V12 M6.3 6.8 A8 8 0 1 0 17.7 6.8" :
        kind == "disk" ? "M4 14 H20 V19 H4 Z M4 14 L7 5 H17 L20 14 M16 16.5 H16.5" :
        kind == "sliders" ? "M4 7 H20 M4 12 H20 M4 17 H20 M9 5 V9 M15 10 V14 M8 15 V19" :
        kind == "bolt" ? "M13 3 L5 14 H12 L11 21 L19 10 H12 Z" :
        kind == "box" ? "M3 7 L12 3 L21 7 V17 L12 21 L3 17 Z M3 7 L12 11 L21 7 M12 11 V21" :
        kind == "chip" ? "M7 7 H17 V17 H7 Z M10 3 V7 M14 3 V7 M10 17 V21 M14 17 V21 M3 10 H7 M3 14 H7 M17 10 H21 M17 14 H21" :
        kind == "memory" ? "M3 8 H21 V16 H3 Z M7 8 V16 M11 8 V16 M15 8 V16 M6 19 V16 M18 19 V16" :
        kind == "monitor" ? "M3 5 H21 V15 H3 Z M9 19 H15 M12 15 V19" :
        kind == "board" ? "M4 4 H20 V20 H4 Z M8 8 H12 V12 H8 Z M15 8 V16 M8 16 H12" :
        kind == "windows" ? "M3 5 L11 4 V11 H3 Z M13 3.8 L21 3 V11 H13 Z M3 13 H11 V20 L3 19 Z M13 13 H21 V21 L13 20 Z" :
        kind == "gear" ? "M12 9 A3 3 0 1 0 12 15 A3 3 0 1 0 12 9 M12 3 V5 M12 19 V21 M3 12 H5 M19 12 H21 M5.6 5.6 L7 7 M17 17 L18.4 18.4 M5.6 18.4 L7 17 M17 7 L18.4 5.6" :
        kind == "search" ? "M11 4 A7 7 0 1 0 11 18 A7 7 0 1 0 11 4 M16 16 L21 21" :
        kind == "game" ? "M6 8 H18 A4 4 0 0 1 22 12 V14 A2.5 2.5 0 0 1 17.5 15 L16 13 H8 L6.5 15 A2.5 2.5 0 0 1 2 14 V12 A4 4 0 0 1 6 8 Z M8 10 V12 M7 11 H9 M15.5 10.5 H15.6 M17.5 12 H17.6" :
        kind == "battery" ? "M3 8 H19 V16 H3 Z M21 11 V13 M6 11 V13 M9 11 V13" :
        kind == "megaphone" ? "M4 10 V14 H7 L14 18 V6 L7 10 Z M17 9 C18.5 10.5 18.5 13.5 17 15" :
        kind == "bulb" ? "M9 18 H15 M10 21 H14 M12 3 A6 6 0 0 0 8.5 14 C9 15 9 16 9 17 H15 C15 16 15 15 15.5 14 A6 6 0 0 0 12 3 Z" :
        kind == "bell" ? "M6 16 V11 A6 6 0 0 1 18 11 V16 L20 18 H4 Z M10 21 H14" :
        kind == "cloud" ? "M7 18 A4 4 0 0 1 6.5 10 A6 6 0 0 1 18 9 A4.5 4.5 0 0 1 17.5 18 Z" :
        kind == "print" ? "M7 9 V4 H17 V9 M7 17 H4 V10 H20 V17 H17 M7 14 H17 V21 H7 Z" :
        kind == "bluetooth" ? "M7 7 L17 17 L12 22 V2 L17 7 L7 17" :
        kind == "map" ? "M3 6 L9 4 L15 6 L21 4 V18 L15 20 L9 18 L3 20 Z M9 4 V18 M15 6 V20" :
        kind == "refresh" ? "M20 12 A8 8 0 1 1 17.7 6.3 M20 4 V9 H15" :
        kind == "globe" ? "M12 3 A9 9 0 1 0 12 21 A9 9 0 1 0 12 3 M3 12 H21 M12 3 C8 8 8 16 12 21 M12 3 C16 8 16 16 12 21" :
        kind == "wrench" ? "M14.5 5.5 A4.5 4.5 0 0 0 19 12 L9 21 L4 16 L12 6.5 A4.5 4.5 0 0 1 14.5 5.5 Z" :
        kind == "clock" ? "M12 4 A8 8 0 1 0 12 20 A8 8 0 1 0 12 4 M12 8 V12 L15 14" :
        kind == "eye" ? "M2 12 C5 6 19 6 22 12 C19 18 5 18 2 12 Z M12 9.5 A2.5 2.5 0 1 0 12 14.5 A2.5 2.5 0 1 0 12 9.5" :
        "M12 3 L20 6 V12 C20 17 16 20 12 21 C8 20 4 17 4 12 V6 Z"; // escudo
}

// Idioma de los textos que arma Rust. `lang` cambia al elegir otro idioma y recalcula todo lo que usa `t`.
export global I18n {
    in property <int> lang;
    pure callback translate(string, int) -> string;
    public pure function t(s: string) -> string { return translate(s, lang); }
}

// Tres jerarquías: principal (acento relleno), normal (relleno sutil) y destructiva (rojo suave). Sin bordes.
component Btn inherits Rectangle {
    in property <string> text;
    in property <bool> strong: false;
    in property <bool> danger: false;
    in property <length> pad: 14px;
    in property <length> font: 12px;
    in property <bool> enabled: true;
    out property <bool> hovered: ta.has-hover;
    callback clicked;
    height: 30px;
    opacity: enabled ? 1.0 : 0.4;
    border-radius: Theme.radius;
    background: strong ? (ta.has-hover ? Theme.accent.with-alpha(0.85) : Theme.accent)
        : (danger ? Theme.danger.with-alpha(ta.has-hover ? 0.24 : 0.13) : (ta.has-hover ? Theme.pressed : Theme.hover));
    animate background { duration: 90ms; }
    HorizontalLayout {
        padding-left: root.pad;
        padding-right: root.pad;
        Text { text: root.text; font-size: root.font; font-weight: 600; color: root.danger ? Theme.danger : (root.strong ? Theme.on-accent : Theme.text); vertical-alignment: center; }
    }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: root.enabled ? MouseCursor.pointer : MouseCursor.default; clicked => { root.clicked(); } }
}

component Toggle inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> locked: false;
    callback toggled(bool);
    opacity: locked ? 0.4 : 1.0;
    width: 38px;
    height: 20px;
    border-radius: 10px;
    border-width: checked ? 0px : 1px;
    border-color: Theme.faint;
    background: checked ? Theme.accent : (ta.has-hover && !locked ? Theme.hover : transparent);
    animate background { duration: 90ms; }
    Rectangle {
        x: root.checked ? 21px : 4px;
        y: root.checked ? 3px : 4px;
        width: root.checked ? 14px : 12px;
        height: self.width;
        border-radius: self.width / 2;
        background: root.checked ? Theme.on-accent : Theme.muted;
        animate x { duration: 110ms; easing: ease-out; }
    }
    ta := TouchArea { enabled: !root.locked; mouse-cursor: root.locked ? MouseCursor.default : MouseCursor.pointer; clicked => { root.checked = !root.checked; root.toggled(root.checked); } }
}

component Bar inherits Rectangle {
    in property <float> value;
    height: 3px;
    border-radius: 1.5px;
    background: Theme.line;
    Rectangle { x: 0; width: parent.width * Math.min(1, Math.max(0, root.value)); border-radius: 1.5px; background: Theme.accent; animate width { duration: 900ms; easing: ease-in-out; } }
}

// Casilla (o círculo si es de elegir una sola opción).
component Check inherits Rectangle {
    in property <bool> checked;
    in property <bool> radio: false;
    width: 20px;
    height: 20px;
    border-radius: radio ? 10px : 5px;
    border-width: checked ? 0px : 1.5px;
    border-color: Theme.faint;
    background: checked ? Theme.accent : transparent;
    animate background { duration: 90ms; }
    if root.checked && !root.radio: Path {
        x: 4px;
        y: 4px;
        width: 12px;
        height: 12px;
        viewbox-width: 12;
        viewbox-height: 12;
        commands: "M2 6.5 L5 9.5 L10 3";
        stroke: Theme.on-accent;
        stroke-width: 1.8px;
        stroke-line-cap: round;
        stroke-line-join: round;
    }
    if root.checked && root.radio: Rectangle { x: 6px; y: 6px; width: 8px; height: 8px; border-radius: 4px; background: Theme.on-accent; }
}

// Etiqueta de riesgo: verde = seguro, amarillo = revisar antes.
component RiskTag inherits Rectangle {
    in property <int> risk;
    height: 20px;
    width: t.preferred-width + 16px;
    border-radius: 10px;
    background: (risk == 0 ? Theme.good : Theme.warn).with-alpha(0.16);
    t := Text {
        text: risk == 0 ? @tr("" => "Seguro") : @tr("" => "Revisar");
        font-size: 12px;
        font-weight: 600;
        color: risk == 0 ? Theme.good : Theme.warn;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

// Entrada del menú lateral: sin caja, solo una marca de acento a la izquierda cuando está activa.
component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <bool> active;
    callback clicked;
    height: 36px;
    border-radius: Theme.radius;
    background: active ? Theme.hover : (ta.has-hover ? Theme.hover.with-alpha(0.5) : transparent);
    Rectangle { x: 0; y: 10px; width: 3px; height: 16px; border-radius: 1.5px; background: active ? Theme.accent : transparent; }
    Icon { x: 16px; y: 10px; kind: root.icon; tint: root.active ? Theme.accent : Theme.muted; }
    Text { x: 44px; text: root.text; font-size: 14px; color: root.active ? Theme.text : Theme.muted; vertical-alignment: center; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Título grande y una línea que explica la pantalla.
component Head inherits VerticalLayout {
    in property <string> title;
    in property <string> sub;
    spacing: 4px;
    Text { text: title; font-size: 28px; font-weight: 600; color: Theme.text; overflow: elide; }
    Text { text: sub; font-size: 14px; color: Theme.muted; wrap: word-wrap; }
}

// Cada pantalla: margen generoso y aire entre bloques.
component Page inherits VerticalLayout {
    padding-left: 32px;
    padding-right: 32px;
    padding-top: 28px;
    padding-bottom: 12px;
    spacing: 16px;
}

// Título de sección, chico y apagado.
component Label inherits Text {
    font-size: 12px;
    font-weight: 600;
    color: Theme.muted;
    vertical-alignment: center;
}

component Search inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback changed(string);
    height: 32px;
    border-radius: Theme.radius;
    border-width: 1px;
    border-color: input.has-focus ? Theme.accent : transparent;
    background: input.has-focus ? Theme.raised : Theme.hover;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        Icon { kind: "search"; tint: Theme.muted; y: 8px; }
        Rectangle {
            horizontal-stretch: 1;
            if input.text == "": Text { text: root.placeholder; color: Theme.faint; font-size: 14px; vertical-alignment: center; }
            input := TextInput {
                width: parent.width;
                height: parent.height;
                font-size: 14px;
                color: Theme.text;
                vertical-alignment: center;
                single-line: true;
                selection-background-color: Theme.accent.with-alpha(0.35);
                edited => { root.text = self.text; root.changed(self.text); }
            }
        }
    }
}

// Lista con scroll: rueda, y una barra mínima sin pista ni fondo que se agranda al pasar el mouse
// y se puede arrastrar. Deja 16 px a la derecha para que el contenido no quede debajo de la barra.
component Scroll inherits Rectangle {
    /// Alto total del contenido (filas x alto de fila). Explícito: calcularlo solo deja valores viejos.
    in property <length> content-h;
    clip: true;
    property <bool> can-scroll: content-h > fl.height;
    property <length> thumb-h: max(28px, fl.height * fl.height / max(1px, content-h));
    property <length> thumb-y: can-scroll ? -fl.content-y / max(1px, content-h - fl.height) * (fl.height - thumb-h) : 0px;
    property <bool> active: strip.has-hover || strip.pressed;

    function scroll-to(ty: length) {
        if (can-scroll) {
            fl.content-y = -(Math.clamp(ty, 0px, fl.height - thumb-h) / max(1px, fl.height - thumb-h)) * (content-h - fl.height);
        }
    }

    fl := Flickable {
        x: 0px;
        width: parent.width - 16px;
        height: parent.height;
        content-height: root.content-h;
        interactive: false;
        @children
    }
    strip := TouchArea {
        x: parent.width - 16px;
        width: 16px;
        height: parent.height;
        enabled: can-scroll;
        property <length> grab;
        pointer-event(e) => {
            if (e.button == PointerEventButton.left && e.kind == PointerEventKind.down) {
                if (self.mouse-y >= thumb-y && self.mouse-y <= thumb-y + thumb-h) {
                    grab = self.mouse-y - thumb-y;
                } else {
                    grab = thumb-h / 2;
                    scroll-to(self.mouse-y - grab);
                }
            }
        }
        moved => {
            if (self.pressed) {
                scroll-to(self.mouse-y - grab);
            }
        }
        scroll-event(e) => {
            fl.content-y = Math.clamp(fl.content-y + e.delta-y, -max(0px, content-h - fl.height), 0px);
            EventResult.accept
        }
    }
    Rectangle {
        visible: can-scroll;
        width: active ? 8px : 3px;
        x: parent.width - self.width - 4px;
        y: thumb-y;
        height: thumb-h;
        border-radius: self.width / 2;
        background: Theme.muted.with-alpha(active ? 0.85 : 0.5);
        animate width { duration: 90ms; }
    }
}

// Diálogo de confirmación centrado, con el resto de la ventana atenuado.
component Confirm inherits Rectangle {
    in property <string> title;
    in property <string> body;
    in property <string> ok-text;
    in property <bool> danger: false;
    callback ok();
    callback cancel();
    background: Theme.dark ? #00000090 : #00000050;
    TouchArea { }  // evita que los clics lleguen a lo que está debajo
    Rectangle {
        width: min(420px, parent.width - 48px);
        height: box.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.pop;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 12px;
        box := VerticalLayout {
            padding: 24px;
            spacing: 8px;
            Text { text: root.title; font-size: 14px; font-weight: 600; color: Theme.text; wrap: word-wrap; }
            Text { text: root.body; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
            Rectangle { height: 12px; }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Btn { text: @tr("" => "Cancelar"); clicked => { root.cancel(); } }
                Btn { text: root.ok-text; strong: !root.danger; danger: root.danger; clicked => { root.ok(); } }
            }
        }
    }
}

// Vista previa: qué se va a hacer, con los valores exactos, antes de tocar nada.
component PreviewDialog inherits Rectangle {
    in property <[PreviewRow]> rows;
    in property <length> rows-h;
    in property <string> note;
    in property <string> ok-text;
    callback ok();
    callback cancel();
    background: Theme.dark ? #00000090 : #00000050;
    TouchArea { }
    Rectangle {
        width: min(600px, parent.width - 48px);
        height: min(parent.height - 64px, 250px + root.rows-h);
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.pop;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 12px;
        VerticalLayout {
            padding: 24px;
            spacing: 12px;
            Text { text: @tr("" => "Esto es lo que se va a hacer"); font-size: 14px; font-weight: 600; color: Theme.text; }
            Text { text: I18n.t(root.note); font-size: 12px; color: Theme.muted; wrap: word-wrap; }
            Scroll {
                vertical-stretch: 1;
                content-h: root.rows-h;
                VerticalLayout {
                    alignment: start;
                    for r in root.rows: VerticalLayout {
                        padding-bottom: 12px;
                        spacing: 2px;
                        HorizontalLayout {
                            spacing: 8px;
                            Text { text: I18n.t(r.title); font-size: 14px; color: Theme.text; wrap: word-wrap; horizontal-stretch: 1; }
                            if !r.undoable: Text { text: @tr("" => "No se puede deshacer"); font-size: 12px; font-weight: 600; color: Theme.warn; vertical-alignment: center; }
                        }
                        Text { text: I18n.t(r.detail); font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                    }
                }
            }
            HorizontalLayout {
                spacing: 8px;
                alignment: end;
                Btn { text: @tr("" => "Cancelar"); clicked => { root.cancel(); } }
                Btn { text: root.ok-text; strong: true; clicked => { root.ok(); } }
            }
        }
    }
}

// Hallazgo de la revisión de comportamiento: severidad, qué es, y las acciones (siempre con confirmación).
// El alto lo estima Rust (finding_height): si se cambia el espaciado hay que cambiarlo allá también.
component FindingCard inherits Rectangle {
    in property <string> title;
    in property <string> detail;
    in property <string> decoded;
    in property <int> severity;
    in property <bool> can-disable;
    in property <bool> can-restore;
    callback ignore();
    callback disable();
    callback restore();
    background: Theme.raised;
    border-width: severity == 0 ? 1px : 0px;
    border-color: Theme.danger.with-alpha(0.55);
    border-radius: 10px;
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 10px;
            Rectangle {
                height: 20px;
                width: chip.preferred-width + 16px;
                border-radius: 10px;
                background: severity == 0 ? Theme.danger.with-alpha(0.18) : Theme.hover;
                chip := Text {
                    text: severity == 0 ? @tr("" => "Alta") : (severity == 1 ? @tr("" => "Media") : @tr("" => "Baja"));
                    font-size: 12px;
                    font-weight: 600;
                    color: severity == 0 ? Theme.danger : (severity == 1 ? Theme.text : Theme.muted);
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            Text { text: I18n.t(root.title); font-size: 14px; color: Theme.text; wrap: word-wrap; horizontal-stretch: 1; }
        }
        Text { text: I18n.t(root.detail); font-size: 12px; color: Theme.muted; wrap: word-wrap; }
        if root.decoded != "": Rectangle {
            background: Theme.hover;
            border-radius: Theme.radius;
            VerticalLayout {
                padding: 8px;
                spacing: 4px;
                Text { text: @tr("" => "Comando real (estaba codificado):"); font-size: 12px; color: Theme.muted; }
                Text { text: I18n.t(root.decoded); font-size: 12px; color: Theme.text; wrap: word-wrap; }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            alignment: end;
            Btn { height: 28px; text: @tr("" => "Ignorar"); clicked => { root.ignore(); } }
            if root.can-disable: Btn { height: 28px; text: @tr("" => "Deshabilitar"); danger: true; clicked => { root.disable(); } }
            if root.can-restore: Btn { height: 28px; text: @tr("" => "Restaurar"); strong: true; clicked => { root.restore(); } }
        }
    }
}

// Botón circular de la revisión: grande y centrado al principio, chico cuando ya hay resultados.
// Un anillo fino; mientras analiza gira un arco y dice qué está haciendo.
component ScanButton inherits Rectangle {
    in property <length> size: 220px;
    in property <bool> busy: false;
    in property <bool> compact: false;
    in property <string> progress;
    in property <string> label: @tr("" => "Analizar");
    in property <string> busy-label: @tr("" => "Analizando");
    in property <bool> enabled: true;
    callback clicked;
    // Una vuelta por segundo, calculada con el reloj de la animación: se redibuja en cada cuadro de la pantalla.
    // Solo depende del reloj mientras `busy`, así que parado no gasta nada.
    property <angle> spin: busy ? Math.mod(animation-tick() / 1s, 1) * 360deg : 0deg;
    opacity: enabled ? 1.0 : 0.45;
    width: size;
    height: size;
    border-radius: size / 2;
    border-width: busy ? 1px : 2px;
    border-color: busy ? Theme.line : Theme.accent;
    background: (ta.has-hover && enabled && !busy) ? Theme.accent.with-alpha(0.14) : Theme.raised;
    animate background { duration: 120ms; }
    Path {
        visible: root.busy;
        width: root.size - 12px;
        height: root.size - 12px;
        x: 6px;
        y: 6px;
        viewbox-width: 100;
        viewbox-height: 100;
        // Un arco de 120° que avanza con `spin`. Se recalcula en cada paso en vez de rotar el dibujo,
        // porque el renderizador liviano de la app no rota las formas.
        commands: "M \{50 + 48 * Math.sin(root.spin)} \{50 - 48 * Math.cos(root.spin)} A 48 48 0 0 1 \{50 + 48 * Math.sin(root.spin + 120deg)} \{50 - 48 * Math.cos(root.spin + 120deg)}";
        stroke: Theme.accent;
        stroke-width: 3px;
        stroke-line-cap: round;
    }
    VerticalLayout {
        alignment: center;
        padding-left: root.compact ? 8px : 32px;
        padding-right: root.compact ? 8px : 32px;
        spacing: 8px;
        Text {
            text: root.busy ? root.busy-label : root.label;
            font-size: root.compact ? 12px : (root.busy ? 14px : 28px);
            font-weight: 600;
            color: Theme.accent;
            horizontal-alignment: center;
        }
        if root.busy && !root.compact: Text {
            text: I18n.t(root.progress);
            font-size: 12px;
            color: Theme.muted;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
    }
    ta := TouchArea { enabled: root.enabled; mouse-cursor: (root.busy || !root.enabled) ? MouseCursor.default : MouseCursor.pointer; clicked => { root.clicked(); } }
}

// Acción secundaria: solo texto, para lo que no es el camino principal.
component TextLink inherits Rectangle {
    in property <string> text;
    callback clicked;
    height: 24px;
    width: t.preferred-width;
    t := Text { text: root.text; font-size: 12px; color: ta.has-hover ? Theme.accent : Theme.muted; vertical-alignment: center; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Elegir una opción entre pocas: una pista con la elegida en relieve.
component Segmented inherits Rectangle {
    in property <[string]> options;
    in property <int> current;
    callback picked(int);
    height: 32px;
    border-radius: Theme.radius;
    background: Theme.hover;
    HorizontalLayout {
        padding: 2px;
        spacing: 2px;
        for o[i] in options: Rectangle {
            border-radius: 4px;
            background: i == root.current ? Theme.chosen : (ta.has-hover ? Theme.hover : transparent);
            animate background { duration: 90ms; }
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                Text { text: o; font-size: 12px; font-weight: i == root.current ? 600 : 400; color: i == root.current ? Theme.text : Theme.muted; vertical-alignment: center; }
            }
            ta := TouchArea { mouse-cursor: pointer; clicked => { root.picked(i); } }
        }
    }
}

// Una fila de configuración: qué es a la izquierda y el control a la derecha. Dentro de una tarjeta.
component ConfigRow inherits Rectangle {
    in property <string> title;
    in property <string> desc;
    in property <bool> last: false;
    height: 72px;
    if !root.last: Rectangle { x: 20px; y: parent.height - 1px; width: parent.width - 40px; height: 1px; background: Theme.line; }
    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        spacing: 16px;
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 2px;
            Text { text: root.title; font-size: 14px; color: Theme.text; }
            Text { text: root.desc; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
        }
        VerticalLayout { alignment: center; @children }
    }
}

// Ícono de un programa; si no se pudo sacar, la inicial en un cuadrito.
component AppIcon inherits Rectangle {
    in property <image> img;
    in property <bool> has-icon;
    in property <string> initial;
    in property <length> size: 24px;
    width: size;
    height: size;
    if root.has-icon: Image { source: root.img; width: parent.width; height: parent.height; image-fit: contain; }
    if !root.has-icon: Rectangle {
        border-radius: Theme.radius;
        background: Theme.hover;
        Text { text: root.initial; font-size: root.size * 0.5; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
    }
}

// Cabecera de columna que ordena la tabla al tocarla.
component ColHead inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    in property <TextHorizontalAlignment> align: left;
    in property <length> inset: 0px;
    callback clicked;
    height: 24px;
    Text { x: root.inset; width: parent.width - root.inset; height: parent.height; text: root.text; font-size: 12px; font-weight: 600; color: root.active ? Theme.accent : (ta.has-hover ? Theme.text : Theme.muted); horizontal-alignment: root.align; vertical-alignment: center; }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// Barra sin fin para lo que tarda un tiempo que no se sabe: un tramo que va y viene, siguiendo el reloj de la animación.
component Busy inherits Rectangle {
    height: 3px;
    border-radius: 1.5px;
    background: Theme.line;
    clip: true;
    Rectangle {
        width: 90px;
        height: parent.height;
        border-radius: 1.5px;
        background: Theme.accent;
        x: (parent.width + 90px) * Math.mod(animation-tick() / 1.4s, 1) - 90px;
    }
}

// Aire entre grupos del menú.
component Gap inherits Rectangle {
    height: 16px;
}

// Cifra grande del panel: qué es, cuánto, una barra fina y un detalle.
component Metric inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <string> caption;
    in property <float> fraction: -1;
    height: 120px;
    // Todas las tarjetas de una fila miden lo mismo, sea cual sea el texto que lleven.
    preferred-width: 0px;
    horizontal-stretch: 1;
    background: Theme.raised;
    border-radius: 10px;
    VerticalLayout {
        padding: 16px;
        spacing: 4px;
        Label { text: root.label; }
        Text { text: root.value; font-size: 32px; font-weight: 300; color: Theme.text; }
        Rectangle { height: 2px; }
        Bar { value: root.fraction; opacity: root.fraction >= 0 ? 1.0 : 0.0; }
        Text { text: root.caption; font-size: 12px; color: Theme.muted; overflow: elide; }
    }
}

// Un disco: nombre, barra de uso y cuánto queda.
component Meter inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <float> fraction;
    height: 64px;
    VerticalLayout {
        alignment: center;
        spacing: 6px;
        Text { text: I18n.t(root.title); font-size: 14px; color: Theme.text; overflow: elide; }
        Bar { value: root.fraction; }
        Text { text: I18n.t(root.sub); font-size: 12px; color: Theme.muted; overflow: elide; }
    }
}

// Dato del equipo: nombre a la izquierda, valor y detalle a la derecha.
component Fact inherits Rectangle {
    in property <string> key;
    in property <string> value;
    in property <string> sub;
    height: 52px;
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
    HorizontalLayout {
        spacing: 16px;
        Text { text: root.key; width: 110px; font-size: 12px; color: Theme.muted; vertical-alignment: center; }
        VerticalLayout {
            horizontal-stretch: 1;
            alignment: center;
            spacing: 1px;
            Text { text: I18n.t(root.value); font-size: 14px; color: Theme.text; overflow: elide; }
            if root.sub != "": Text { text: I18n.t(root.sub); font-size: 12px; color: Theme.muted; overflow: elide; }
        }
    }
}

// Tarjeta de Seguridad: ícono, título y detalle.
component Info inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> sub;
    in property <bool> alert: false;
    background: Theme.raised;
    border-width: alert ? 1px : 0px;
    border-color: Theme.danger.with-alpha(0.55);
    border-radius: 10px;
    min-height: 68px;
    HorizontalLayout {
        padding: 14px;
        spacing: 12px;
        Icon { kind: root.icon; tint: root.alert ? Theme.danger : Theme.muted; y: 2px; width: 20px; height: 20px; }
        VerticalLayout {
            spacing: 3px;
            alignment: center;
            Text { text: I18n.t(title); font-size: 14px; color: Theme.text; overflow: elide; }
            Text { text: I18n.t(sub); font-size: 12px; color: Theme.muted; overflow: elide; }
        }
    }
}

export component Main inherits Window {
    title: "lumen";
    icon: @image-url("../assets/icon.png");
    preferred-width: 980px;
    preferred-height: 740px;
    min-width: 720px;
    min-height: 640px;
    // Transparente: Rust le pone el material de Windows (Mica) por detrás.
    background: Theme.solid ? Theme.backdrop : transparent;
    default-font-family: "Segoe UI Variable Text";

    in property <float> cpu;
    in property <float> ram;
    in property <float> gpu: -1;
    in property <float> disk;
    in property <string> ram-text;
    in property <string> disk-text;
    in property <string> net-text;
    in property <[Row]> procs;
    in property <[StartupRow]> startup;
    in-out property <int> cfg-theme: 0;
    in-out property <int> cfg-refresh: 0;
    in-out property <int> cfg-lang: 0;
    in property <string> app-version;
    callback config-changed();
    in property <[OptRow]> opt-rows;
    in property <length> opt-h;
    in property <int> opt-done;
    in property <int> opt-total;
    in property <int> opt-advanced;
    in-out property <bool> show-advanced;
    in-out property <bool> opt-confirm;
    in property <[ServiceRow]> privacy;
    in property <[ServiceRow]> services;
    in property <[ServiceRow]> profiles;
    in property <Hw> hw;
    in property <[DiskCard]> disks;
    in property <[SecRow]> sec-cards;
    in property <[SecRow]> threats;
    in property <[FindingRow]> findings;
    in property <length> findings-h;
    in-out property <bool> behavior-run;
    in-out property <bool> behavior-busy;
    in-out property <string> progress;
    in-out property <int> sec-confirm: -1;
    in-out property <int> sec-confirm-action;
    in-out property <string> sec-status;
    in property <[AppRow]> apps;
    in property <[DiskRow]> leftovers;
    in-out property <bool> can-undo-leftovers;
    in-out property <string> apps-sort-label: @tr("" => "nombre");
    in-out property <int> confirm-app: -1;
    in-out property <string> confirm-app-name;
    in-out property <string> status;
    in property <[SpaceRow]> space-map;
    // Limpieza de disco: una sola acción. 0 = listo para limpiar, 1 = limpiando, 2 = limpiado (se puede deshacer), 3 = terminado.
    in property <bool> disk-loading;
    in property <bool> disk-nothing;
    in property <[CleanRow]> disk-items;
    // Inicio: estado de la PC, análisis y presets. 0 = sin analizar, 1 = analizando, 2 = listo, 3 = aplicado.
    in-out property <int> home-state: 0;
    in property <string> home-free;
    in property <int> home-startup;
    in-out property <int> home-preset: 1;
    in property <int> home-count;
    in property <string> home-desc;
    in-out property <int> disk-tab: 0;
    in property <[DupRow]> dup-rows;
    in property <string> dup-total;
    in-out property <int> dup-phase: 0;
    in-out property <string> dup-result;
    in-out property <bool> dup-can-undo: false;
    // Secciones con opciones (Privacidad, ...): Rust llena la lista y aplica lo elegido.
    in property <[OptionRow]> sc-rows;
    in property <length> sc-h;
    in property <string> sc-title;
    in property <string> sc-sub;
    in property <string> sc-button;
    in property <int> sc-selected;
    in property <int> sc-more-count;
    in-out property <bool> sc-more;
    in-out property <string> sc-result;
    in-out property <bool> sc-busy;
    in-out property <bool> sc-loading;
    in-out property <bool> sc-preview;
    in property <[PreviewRow]> sc-preview-rows;
    in property <length> sc-preview-h;
    in property <string> sc-preview-note;
    in property <[HistRow]> hist;
    in property <string> hist-status;
    in property <string> disk-total;
    in property <string> disk-parts;
    in property <string> disk-old;
    in-out property <int> disk-phase: 0;
    in-out property <string> disk-result;
    in-out property <bool> show-map;
    in-out property <int> page: 0;
    // pid pendiente de confirmar para cerrar (-1 = ninguno)
    in-out property <int> kill-pid: -1;
    in-out property <string> kill-name;
    in-out property <int> sort-by: 0;
    property <[string]> pages: [@tr("" => "Panel"), @tr("" => "Procesos"), @tr("" => "Arranque"), @tr("" => "Disco"), @tr("" => "Privacidad"), @tr("" => "Servicios"), @tr("" => "Perfiles"), @tr("" => "Programas"), @tr("" => "Seguridad"), @tr("" => "Configuración")];

    callback sort(int);
    callback kill(int);
    callback opened();
    callback toggle-startup(int, bool);
    callback toggle-opt(int, int, bool);
    callback rebuild-opt();
    callback apply-recommended();
    callback apply-recommended-services(string);
    callback toggle-privacy(int, bool);
    callback toggle-service(int, bool);
    callback toggle-profile(int, bool);
    callback uninstall(int);
    callback scan-behavior();
    callback behavior-ready();
    callback finding-do(int, int);
    callback apps-reload();
    callback home-analyze();
    callback home-ready();
    callback home-select(int);
    callback home-apply();
    callback dup-scan();
    callback dup-found();
    callback dup-clean();
    callback dup-undo();
    callback dup-reset();
    callback sc-toggle(int);
    callback sc-apply();
    callback sc-run();
    callback sc-finish();
    callback sc-loaded();
    callback sc-reload();
    callback hist-undo(int);
    callback icons-ready();
    callback apps-rebuild();
    callback apps-filter(string);
    callback apps-sort(int);
    callback clean-leftovers();
    callback undo-leftovers();
    callback dismiss-leftovers();
    callback disable-service(int, string);
    callback clean-all();
    callback disk-reset();
    callback undo-clean();
    callback purge();
    callback scan-map();
    toggle-opt(kind, src, on) => {
        if (kind == 0) { toggle-privacy(src, on); } else if (kind == 1) { toggle-service(src, on); } else { toggle-profile(src, on); }
    }
    changed page => { opened(); }

    HorizontalLayout {
        // Menú: sin fondo propio, se ve el material de la ventana.
        VerticalLayout {
            width: 208px;
            padding-left: 12px;
            padding-right: 12px;
            padding-top: 8px;
            padding-bottom: 12px;
            VerticalLayout {
                vertical-stretch: 1;
                spacing: 2px;
                alignment: start;
                HorizontalLayout {
                    height: 44px;
                    padding-left: 16px;
                    spacing: 10px;
                    Rectangle { width: 8px; VerticalLayout { alignment: center; Rectangle { width: 8px; height: 8px; border-radius: 4px; background: Theme.accent; } } }
                    Text { text: "lumen"; font-size: 14px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                }
                NavItem { text: @tr("" => "Inicio"); icon: "home"; active: page == 0; clicked => { page = 0; } }
                NavItem { text: @tr("" => "Limpieza"); icon: "disk"; active: page == 3; clicked => { page = 3; } }
                NavItem { text: @tr("" => "Rendimiento"); icon: "bolt"; active: page == 10; clicked => { sc-result = ""; page = 10; } }
                NavItem { text: @tr("" => "Privacidad"); icon: "eye"; active: page == 11; clicked => { sc-result = ""; page = 11; } }
                NavItem { text: @tr("" => "Red"); icon: "globe"; active: page == 12; clicked => { sc-result = ""; page = 12; } }
                NavItem { text: @tr("" => "Reparación"); icon: "wrench"; active: page == 13; clicked => { sc-result = ""; page = 13; } }
                NavItem { text: @tr("" => "Actualizaciones"); icon: "refresh"; active: page == 14; clicked => { sc-result = ""; page = 14; } }
                NavItem { text: @tr("" => "Historial"); icon: "clock"; active: page == 15; clicked => { page = 15; } }
                Gap { }
                NavItem { text: @tr("" => "Procesos"); icon: "list"; active: page == 1; clicked => { page = 1; } }
                NavItem { text: @tr("" => "Programas"); icon: "box"; active: page == 7; clicked => { page = 7; } }
                NavItem { text: @tr("" => "Seguridad"); icon: "shield"; active: page == 8; clicked => { page = 8; } }
            }
            NavItem { text: @tr("" => "Configuración"); icon: "gear"; active: page == 9; clicked => { page = 9; } }
        }

        // Hoja de contenido: una capa translúcida con las esquinas redondeadas apoyada sobre el material.
        VerticalLayout {
            padding-right: 8px;
            padding-bottom: 8px;
            sheet := Rectangle {
                background: Theme.sheet;
                border-radius: 10px;
                border-width: 1px;
                border-color: Theme.line;
                // Sin `clip`: un recorte redondeado sobre un fondo translúcido rompe el repintado parcial (queda más claro).

                if page == 0: Page {
                    width: parent.width;
                    height: parent.height;
                    Head { title: @tr("" => "Inicio"); sub: @tr("" => "El estado de tu PC de un vistazo. La memoria se actualiza sola."); }
                    Scroll {
                        vertical-stretch: 1;
                        content-h: 778px + disks.length * 64px;
                        VerticalLayout {
                            alignment: start;
                            // Estado de la PC y el análisis: tres cifras, el botón Analizar y los presets.
                            HorizontalLayout {
                                spacing: 12px;
                                height: 120px;
                                Metric { label: @tr("" => "Se puede liberar"); value: home-state >= 2 ? home-free : "—"; caption: home-state >= 2 ? @tr("" => "Temporales, cachés y restos") : @tr("" => "Analizá para saberlo"); }
                                Metric { label: @tr("" => "Apps al iniciar"); value: home-state >= 2 ? "\{home-startup}" : "—"; caption: home-state >= 2 ? @tr("" => "arrancan con Windows") : @tr("" => "Analizá para saberlo"); }
                                Metric { label: @tr("" => "Memoria en uso"); value: "\{Math.round(ram * 100)} %"; caption: ram-text; fraction: ram; }
                            }
                            Rectangle { height: 16px; }
                            Rectangle {
                                height: 134px;
                                if home-state == 0: HorizontalLayout {
                                    spacing: 16px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;
                                        Text { text: @tr("" => "Analizá tu PC"); font-size: 14px; color: Theme.text; }
                                        Text { text: @tr("" => "Revisa qué se puede liberar y mejorar. No cambia nada hasta que lo confirmes."); font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                    }
                                    VerticalLayout { alignment: center; horizontal-stretch: 0; Btn { height: 38px; pad: 28px; font: 14px; strong: true; text: @tr("" => "Analizar"); clicked => { home-analyze(); } } }
                                }
                                if home-state == 1: VerticalLayout {
                                    alignment: center;
                                    spacing: 10px;
                                    Text { text: @tr("" => "Analizando tu PC…"); font-size: 14px; color: Theme.muted; horizontal-alignment: center; }
                                    HorizontalLayout { alignment: center; Busy { width: 260px; } }
                                }
                                if home-state == 2: VerticalLayout {
                                    spacing: 10px;
                                    HorizontalLayout { alignment: start; Segmented { options: [@tr("" => "Mínimo"), @tr("" => "Recomendado"), @tr("" => "Avanzado")]; current: home-preset; picked(i) => { home-preset = i; home-select(i); } } }
                                    Text { height: 32px; text: I18n.t(home-desc); font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                    HorizontalLayout {
                                        spacing: 16px;
                                        Text {
                                            horizontal-stretch: 1;
                                            text: home-count == 0 ? @tr("" => "No hay nada pendiente en este nivel.") : (home-count == 1 ? @tr("" => "1 ajuste. Antes de aplicar te mostramos qué se va a hacer.") : @tr("" => "{} ajustes. Antes de aplicar te mostramos qué se va a hacer.", home-count));
                                            font-size: 12px;
                                            color: Theme.muted;
                                            wrap: word-wrap;
                                            vertical-alignment: center;
                                        }
                                        Btn { height: 38px; pad: 28px; font: 14px; strong: true; enabled: home-count > 0 && !sc-busy; text: @tr("" => "Optimizar"); clicked => { home-apply(); } }
                                    }
                                }
                                if home-state == 3: VerticalLayout {
                                    alignment: center;
                                    spacing: 12px;
                                    Text { text: I18n.t(sc-result); font-size: 14px; color: Theme.accent; wrap: word-wrap; }
                                    HorizontalLayout { alignment: start; Btn { text: @tr("" => "Analizar de nuevo"); clicked => { home-analyze(); } } }
                                }
                            }
                            Rectangle { height: 28px; }
                            HorizontalLayout {
                                spacing: 12px;
                                height: 120px;
                                Metric { label: @tr("" => "Procesador"); value: "\{Math.round(cpu * 100)} %"; caption: hw.cpu; fraction: cpu; }
                                Metric { label: @tr("" => "Gráficos"); value: gpu >= 0 ? "\{Math.round(gpu * 100)} %" : "—"; caption: hw.gpu; fraction: gpu; }
                            }
                            Rectangle { height: 28px; }
                            Label { height: 28px; text: @tr("" => "Almacenamiento"); }
                            for d in disks: Meter { title: d.name; sub: d.sub; fraction: d.fraction; }
                            Rectangle { height: 20px; }
                            Label { height: 28px; text: @tr("" => "Equipo"); }
                            Fact { key: @tr("" => "Sistema"); value: hw.os; sub: hw.os-sub; }
                            Fact { key: @tr("" => "Procesador"); value: hw.cpu; sub: hw.cpu-sub; }
                            Fact { key: @tr("" => "Gráficos"); value: hw.gpu; sub: hw.gpu-sub; }
                            Fact { key: @tr("" => "Placa base"); value: hw.board; sub: hw.board-sub; }
                            Fact { key: @tr("" => "Red"); value: net-text; }
                        }
                    }
                }

                if page == 1: Page {
                    width: parent.width;
                    height: parent.height;
                    Head { title: @tr("" => "{} procesos", procs.length); sub: sort-by == 0 ? @tr("" => "Ordenados por uso de CPU. Tocá un proceso para cerrarlo.") : (sort-by == 1 ? @tr("" => "Ordenados por memoria. Tocá un proceso para cerrarlo.") : @tr("" => "Ordenados por nombre. Tocá un proceso para cerrarlo.")); }
                    // Tabla: tocar el título de una columna la ordena.
                    HorizontalLayout {
                        height: 24px;
                        spacing: 12px;
                        padding-left: 10px;
                        padding-right: 26px;
                        ColHead { width: 190px; inset: 30px; text: @tr("" => "Nombre"); active: sort-by == 2; clicked => { sort-by = 2; sort(2); } }
                        ColHead { width: 44px; text: "CPU"; align: right; active: sort-by == 0; clicked => { sort-by = 0; sort(0); } }
                        ColHead { width: 76px; text: @tr("" => "Memoria"); align: right; active: sort-by == 1; clicked => { sort-by = 1; sort(1); } }
                        ColHead { text: @tr("" => "Ubicación"); horizontal-stretch: 1; }
                    }
                    Rectangle { height: 1px; background: Theme.line; }
                    Scroll {
                        content-h: procs.length * 34px;
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            for p in procs: Rectangle {
                                height: 34px;
                                border-radius: Theme.radius;
                                // Sin botón: al pasar el mouse la fila se pone roja, y tocarla pide confirmar antes de cerrar.
                                background: ta.has-hover ? Theme.danger.with-alpha(0.3) : transparent;
                                animate background { duration: 90ms; }
                                ta := TouchArea { mouse-cursor: pointer; clicked => { kill-name = p.name; kill-pid = p.pid; } }
                                HorizontalLayout {
                                    spacing: 12px;
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    HorizontalLayout {
                                        width: 190px;
                                        spacing: 10px;
                                        VerticalLayout { alignment: center; AppIcon { size: 20px; img: p.icon; has-icon: p.has-icon; initial: p.initial; } }
                                        Text { text: p.name; font-size: 14px; color: Theme.text; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                                    }
                                    Text { text: p.cpu; width: 44px; font-size: 14px; color: p.cpu == "0%" ? Theme.faint : Theme.text; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { text: p.mem; width: 76px; font-size: 14px; color: Theme.muted; horizontal-alignment: right; vertical-alignment: center; }
                                    Text { text: p.path; font-size: 12px; color: Theme.faint; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
                                }
                            }
                        }
                    }
                }

if page == 2: Page {
                    width: parent.width;
                    height: parent.height;
                    Head { title: @tr("" => "{} apps arrancan con Windows", startup.length); sub: @tr("" => "Desactivarlas no las borra. Podés volver a activarlas cuando quieras."); }
                    if status != "": Text { text: I18n.t(status); font-size: 12px; color: Theme.danger; }
                    Scroll {
                        content-h: startup.length * 60px;
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            for e[i] in startup: Rectangle {
                                height: 60px;
                                // Cada app es una pieza: las apagadas se ven más tenues.
                                Rectangle {
                                    height: 54px;
                                    border-radius: 8px;
                                    background: st-ta.has-hover ? Theme.chosen : Theme.raised;
                                    animate background { duration: 90ms; }
                                    st-ta := TouchArea { }
                                    HorizontalLayout {
                                        spacing: 16px;
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        VerticalLayout { alignment: center; AppIcon { size: 32px; img: e.icon; has-icon: e.has-icon; initial: e.initial; opacity: e.enabled ? 1.0 : 0.5; } }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            opacity: e.enabled ? 1.0 : 0.5;
                                            Text { text: e.name; font-size: 14px; color: Theme.text; overflow: elide; }
                                            Text { text: e.command; font-size: 12px; color: Theme.muted; overflow: elide; }
                                        }
                                        Text { text: I18n.t(e.scope); font-size: 12px; color: Theme.faint; vertical-alignment: center; }
                                        VerticalLayout { alignment: center; Toggle { checked: e.enabled; toggled(on) => { toggle-startup(i, on); } } }
                                    }
                                }
                            }
                        }
                    }
                }

if page == 3: Page {
                    width: parent.width;
                    height: parent.height;
                    Head { title: @tr("" => "Limpieza"); sub: @tr("" => "Lo que sobra en tu disco: temporales, cachés, restos de Windows Update y archivos repetidos."); }
                    HorizontalLayout {
                        alignment: start;
                        Segmented { options: [@tr("" => "Limpiar"), @tr("" => "Duplicados"), @tr("" => "Espacio")]; current: disk-tab; picked(i) => { disk-tab = i; if (i == 2 && space-map.length == 0) { scan-map(); } } }
                    }

                    // Limpiar: la cifra grande, qué se va a mover y un solo botón.
                    if disk-tab == 0: VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 14px;
                        // Antes de limpiar: cuánto se libera, qué se va a mover y un solo botón.
                if disk-phase < 2: VerticalLayout {
                    vertical-stretch: 1;
                    spacing: 14px;
                    VerticalLayout {
                        Text {
                            text: disk-loading ? @tr("" => "Calculando…") : (disk-nothing ? @tr("" => "No hay nada para limpiar") : disk-total);
                            font-size: (disk-nothing || disk-loading) ? 28px : 48px;
                            font-weight: 300;
                            color: Theme.text;
                        }
                        if !disk-loading && !disk-nothing: Text { text: @tr("" => "Se puede liberar. Esto es lo que se va a mover:"); font-size: 14px; color: Theme.muted; }
                    }
                    if !disk-loading && !disk-nothing: Scroll {
                        vertical-stretch: 1;
                        content-h: disk-items.length * 66px;
                        VerticalLayout {
                            alignment: start;
                            for it in disk-items: Rectangle {
                                height: 66px;
                                Rectangle {
                                    height: 60px;
                                    border-radius: 8px;
                                    background: Theme.raised;
                                    HorizontalLayout {
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        spacing: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: I18n.t(it.name); font-size: 14px; color: Theme.text; overflow: elide; }
                                            Text { text: I18n.t(it.desc); font-size: 12px; color: Theme.muted; overflow: elide; }
                                        }
                                        Text { text: it.size; font-size: 14px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                    if disk-loading || disk-nothing: Rectangle { vertical-stretch: 1; }
                    if disk-old != "": Text { text: I18n.t(disk-old); font-size: 12px; color: Theme.faint; wrap: word-wrap; }
                    HorizontalLayout {
                        spacing: 16px;
                        if disk-phase == 0 && !disk-loading && !disk-nothing: Text {
                            horizontal-stretch: 1;
                            text: @tr("" => "No se borra al instante: queda guardado 7 días y podés deshacerlo.");
                            font-size: 12px;
                            color: Theme.muted;
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }
                        if disk-phase == 0 && !disk-loading && !disk-nothing: Btn { height: 38px; pad: 28px; font: 14px; strong: true; text: @tr("" => "Limpiar"); clicked => { clean-all(); } }
                        if disk-phase == 1: VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 10px;
                            Text { text: @tr("" => "Limpiando"); font-size: 14px; color: Theme.muted; }
                            Busy { }
                        }
                    }
                }

                // Después: qué pasó y, si se puede, deshacerlo.
                if disk-phase >= 2: VerticalLayout {
                    vertical-stretch: 1;
                    alignment: center;
                    spacing: 16px;
                    Text { text: I18n.t(disk-result); font-size: 28px; font-weight: 300; color: Theme.text; horizontal-alignment: center; wrap: word-wrap; }
                    if disk-phase == 2: Text {
                        text: @tr("" => "Los archivos quedan guardados 7 días por si algo falla. El espacio se libera cuando se borran.");
                        font-size: 12px;
                        color: Theme.muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        if disk-phase == 2: Btn { height: 36px; pad: 20px; text: @tr("" => "Deshacer"); clicked => { undo-clean(); } }
                        if disk-phase == 2: Btn { height: 36px; pad: 20px; text: @tr("" => "Borrar ahora"); strong: true; clicked => { purge(); } }
                        if disk-phase == 3: Btn { height: 36px; pad: 20px; text: @tr("" => "Volver"); clicked => { disk-reset(); } }
                    }
                }

                    }

                    // Duplicados: archivos idénticos en tus carpetas personales. Las copias van a la reserva.
                    if disk-tab == 1: VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 14px;
                        if dup-phase == 0: VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            spacing: 14px;
                            Text { text: @tr("" => "Archivos repetidos"); font-size: 28px; font-weight: 300; color: Theme.text; horizontal-alignment: center; }
                            Text { text: @tr("" => "Busca archivos idénticos en Descargas, Documentos, Escritorio, Imágenes, Videos y Música. No borra nada: te muestra los grupos y las copias van a la reserva, donde se pueden devolver."); font-size: 14px; color: Theme.muted; horizontal-alignment: center; wrap: word-wrap; }
                            HorizontalLayout { alignment: center; Btn { height: 38px; pad: 28px; font: 14px; strong: true; text: @tr("" => "Buscar duplicados"); clicked => { dup-scan(); } } }
                        }
                        if dup-phase == 1: VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            spacing: 10px;
                            Text { text: @tr("" => "Buscando archivos repetidos…"); font-size: 14px; color: Theme.muted; horizontal-alignment: center; }
                            HorizontalLayout { alignment: center; Busy { width: 260px; } }
                        }
                        if dup-phase == 2 && dup-rows.length == 0: VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            spacing: 14px;
                            Text { text: @tr("" => "No encontré archivos repetidos"); font-size: 28px; font-weight: 300; color: Theme.text; horizontal-alignment: center; }
                            HorizontalLayout { alignment: center; Btn { height: 36px; pad: 20px; text: @tr("" => "Buscar de nuevo"); clicked => { dup-reset(); } } }
                        }
                        if dup-phase == 2 && dup-rows.length > 0: VerticalLayout {
                            vertical-stretch: 1;
                            spacing: 14px;
                            VerticalLayout {
                                Text { text: dup-total; font-size: 48px; font-weight: 300; color: Theme.text; }
                                Text { text: @tr("" => "Se puede liberar. De cada grupo se conserva el archivo más antiguo; las copias van a la reserva."); font-size: 14px; color: Theme.muted; wrap: word-wrap; }
                            }
                            Scroll {
                                vertical-stretch: 1;
                                content-h: dup-rows.length * 66px;
                                VerticalLayout {
                                    alignment: start;
                                    for d in dup-rows: Rectangle {
                                        height: 66px;
                                        Rectangle {
                                            height: 60px;
                                            border-radius: 8px;
                                            background: Theme.raised;
                                            HorizontalLayout {
                                                padding-left: 16px;
                                                padding-right: 16px;
                                                spacing: 16px;
                                                VerticalLayout {
                                                    horizontal-stretch: 1;
                                                    alignment: center;
                                                    spacing: 2px;
                                                    Text { text: d.name; font-size: 14px; color: Theme.text; overflow: elide; }
                                                    Text { text: d.copies == 1 ? @tr("" => "Se conserva el de {} · 1 copia", d.folder) : @tr("" => "Se conserva el de {} · {} copias", d.folder, d.copies); font-size: 12px; color: Theme.muted; overflow: elide; }
                                                }
                                                Text { text: d.wasted; font-size: 14px; font-weight: 600; color: Theme.text; vertical-alignment: center; }
                                            }
                                        }
                                    }
                                }
                            }
                            HorizontalLayout {
                                spacing: 16px;
                                Text { horizontal-stretch: 1; text: @tr("" => "No se borra al instante: queda guardado 7 días y podés deshacerlo."); font-size: 12px; color: Theme.muted; wrap: word-wrap; vertical-alignment: center; }
                                Btn { height: 38px; pad: 28px; font: 14px; strong: true; text: @tr("" => "Mover las copias"); clicked => { dup-clean(); } }
                            }
                        }
                        if dup-phase == 3: VerticalLayout {
                            vertical-stretch: 1;
                            alignment: center;
                            spacing: 16px;
                            Text { text: I18n.t(dup-result); font-size: 28px; font-weight: 300; color: Theme.text; horizontal-alignment: center; wrap: word-wrap; }
                            HorizontalLayout {
                                alignment: center;
                                spacing: 8px;
                                if dup-can-undo: Btn { height: 36px; pad: 20px; text: @tr("" => "Deshacer"); clicked => { dup-undo(); } }
                                Btn { height: 36px; pad: 20px; strong: true; text: @tr("" => "Listo"); clicked => { dup-reset(); } }
                            }
                        }
                    }

                    // Espacio: qué carpetas ocupan más, en barras.
                    if disk-tab == 2: VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 12px;
                        Text { text: @tr("" => "Lo que más ocupa en tu carpeta de usuario"); font-size: 14px; color: Theme.muted; }
                        Scroll {
                            vertical-stretch: 1;
                            content-h: space-map.length * 58px;
                            VerticalLayout {
                                alignment: start;
                                for m in space-map: Rectangle {
                                    height: 58px;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 8px;
                                        HorizontalLayout {
                                            spacing: 12px;
                                            Text { text: m.name; font-size: 14px; color: Theme.text; overflow: elide; horizontal-stretch: 1; }
                                            Text { text: m.size; font-size: 14px; font-weight: 600; color: Theme.text; }
                                        }
                                        Bar { height: 8px; value: m.fraction; }
                                    }
                                }
                            }
                        }
                    }
                }

if page == 4: Page {
                    width: parent.width;
                    height: parent.height;
                    Head { title: @tr("" => "Optimizar"); sub: @tr("" => "Mejoras opcionales para tu PC. Cada una se puede volver atrás desde acá."); }
                    // Avance: cuántas de las recomendadas ya están aplicadas.
                    VerticalLayout {
                        vertical-stretch: 0;
                        spacing: 10px;
                        HorizontalLayout {
                            spacing: 16px;
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;
                                Text { text: @tr("" => "Aplicaste {} de {} mejoras recomendadas", opt-done, opt-total); font-size: 14px; color: Theme.text; }
                                if status != "": Text { text: I18n.t(status); font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                            }
                            if opt-done < opt-total: VerticalLayout {
                                alignment: center;
                                Btn { text: @tr("" => "Aplicar las recomendadas"); strong: true; clicked => { opt-confirm = true; } }
                            }
                        }
                        Bar { value: opt-total > 0 ? opt-done / opt-total : 0; }
                    }
                    Scroll {
                        vertical-stretch: 1;
                        content-h: opt-h;
                        // Tarjetas en dos columnas. Rust calcula `y` y `col` de cada una (y el alto total en `opt-h`).
                        Rectangle {
                            x: 0px;
                            y: 0px;
                            // Ancho de la hoja menos los márgenes de la página (64) y la barra de scroll (16): `parent.width` en un Flickable no es el visible.
                            width: sheet.width - 80px;
                            height: opt-h;
                            for r[i] in opt-rows: Rectangle {
                                x: r.header ? 0px : r.col * (parent.width + 12px) / 2;
                                y: r.y * 1px;
                                width: r.header ? parent.width : (parent.width - 12px) / 2;
                                height: r.header ? 44px : 112px;
                                if r.header: Label { x: 4px; y: parent.height - 28px; height: 20px; text: I18n.t(r.title); }
                                if !r.header: Rectangle {
                                    border-radius: 12px;
                                    background: opt-ta.has-hover ? Theme.chosen : Theme.raised;
                                    border-width: r.enabled ? 1px : 0px;
                                    border-color: Theme.accent.with-alpha(0.45);
                                    animate background { duration: 90ms; }
                                    opt-ta := TouchArea { }
                                    // Arriba el ícono y el interruptor; abajo el nombre. Al pasar el mouse el nombre deja lugar a la explicación.
                                    Rectangle {
                                        x: 16px;
                                        y: 16px;
                                        width: 36px;
                                        height: 36px;
                                        border-radius: 10px;
                                        background: r.enabled ? Theme.accent.with-alpha(0.18) : Theme.hover;
                                        animate background { duration: 120ms; }
                                        Icon { x: 10px; y: 10px; width: 16px; height: 16px; kind: r.icon; tint: r.enabled ? Theme.accent : Theme.muted; }
                                    }
                                    HorizontalLayout {
                                        x: 0px;
                                        y: 22px;
                                        width: parent.width;
                                        height: 24px;
                                        padding-right: 16px;
                                        spacing: 10px;
                                        alignment: end;
                                        if r.tag != "": Text { text: I18n.t(r.tag); font-size: 12px; color: Theme.faint; vertical-alignment: center; }
                                        Toggle { checked: r.enabled; locked: r.locked; y: 2px; toggled(on) => { toggle-opt(r.kind, r.src, on); } }
                                    }
                                    Text {
                                        x: 16px;
                                        y: 64px;
                                        width: parent.width - 32px;
                                        height: 38px;
                                        text: I18n.t(r.title);
                                        font-size: 14px;
                                        color: Theme.text;
                                        wrap: word-wrap;
                                        overflow: elide;
                                        opacity: opt-ta.has-hover ? 0.0 : 1.0;
                                        animate opacity { duration: 100ms; }
                                    }
                                    Text {
                                        x: 16px;
                                        y: 62px;
                                        width: parent.width - 32px;
                                        height: 42px;
                                        text: I18n.t(r.desc);
                                        font-size: 12px;
                                        color: Theme.muted;
                                        wrap: word-wrap;
                                        overflow: elide;
                                        opacity: opt-ta.has-hover ? 1.0 : 0.0;
                                        animate opacity { duration: 100ms; }
                                    }
                                }
                            }
                            if opt-advanced > 0: TextLink {
                                x: 4px;
                                y: parent.height - 32px;
                                text: show-advanced ? @tr("" => "Ocultar las opciones avanzadas") : @tr("" => "Mostrar las opciones avanzadas ({})", opt-advanced);
                                clicked => { show-advanced = !show-advanced; rebuild-opt(); }
                            }
                        }
                    }
                }

                if page == 7: Page {
                    width: parent.width;
                    height: parent.height;
                    Head { title: @tr("" => "{} programas", apps.length); sub: @tr("" => "Abre el desinstalador de cada programa y después te muestra lo que quedó. Orden: {}.", I18n.t(apps-sort-label)); }
                    HorizontalLayout {
                        spacing: 8px;
                        Search { placeholder: @tr("" => "Buscar programa o editor"); changed(t) => { apps-filter(t); } horizontal-stretch: 1; }
                        Btn { height: 32px; text: @tr("" => "Nombre"); clicked => { apps-sort(0); } }
                        Btn { height: 32px; text: @tr("" => "Peso"); clicked => { apps-sort(1); } }
                        Btn { height: 32px; text: @tr("" => "Editor"); clicked => { apps-sort(2); } }
                    }
                    if status != "": Text { text: I18n.t(status); font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                    if leftovers.length > 0: VerticalLayout {
                        spacing: 6px;
                        Text { text: @tr("" => "Quedaron {} restos. Revisalos antes de limpiar:", leftovers.length); font-size: 14px; color: Theme.text; }
                        for l in leftovers: HorizontalLayout {
                            spacing: 12px;
                            Text { text: l.size; width: 64px; font-size: 12px; color: Theme.muted; }
                            Text { text: l.name; font-size: 12px; color: Theme.text; overflow: elide; horizontal-stretch: 1; }
                        }
                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Btn { text: @tr("" => "Mover a la reserva"); strong: true; clicked => { clean-leftovers(); } }
                            Btn { text: @tr("" => "Dejarlos"); clicked => { dismiss-leftovers(); } }
                        }
                    }
                    if can-undo-leftovers: HorizontalLayout { alignment: start; Btn { text: @tr("" => "Deshacer limpieza de restos"); clicked => { undo-leftovers(); } } }
                    Scroll {
                        content-h: apps.length * 44px;
                        vertical-stretch: 1;
                        VerticalLayout {
                            alignment: start;
                            for a[i] in apps: Rectangle {
                                height: 44px;
                                border-radius: Theme.radius;
                                background: (app-ta.has-hover || un-btn.hovered) ? Theme.hover : transparent;
                                app-ta := TouchArea { }
                                HorizontalLayout {
                                    spacing: 12px;
                                    padding-left: 10px;
                                    padding-right: 6px;
                                    VerticalLayout { alignment: center; AppIcon { size: 24px; img: a.icon; has-icon: a.has-icon; initial: a.initial; } }
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text { text: a.name; font-size: 14px; color: Theme.text; overflow: elide; }
                                        Text { text: a.detail; font-size: 12px; color: Theme.muted; overflow: elide; }
                                    }
                                    Text { text: a.size; width: 70px; font-size: 12px; color: Theme.faint; horizontal-alignment: right; vertical-alignment: center; }
                                    VerticalLayout { alignment: center; un-btn := Btn { text: @tr("" => "Desinstalar"); danger: true; height: 26px; visible: app-ta.has-hover || un-btn.hovered; clicked => { confirm-app-name = a.name; confirm-app = i; } } }
                                }
                            }
                        }
                    }
                }

                if page == 8: Page {
                    width: parent.width;
                    height: parent.height;
                    Head { title: @tr("" => "Seguridad"); sub: @tr("" => "Revisa Windows Defender, lo que arranca solo, las conexiones, los procesos y los drivers. No reemplaza a un antivirus."); }

                    // Antes del primer análisis: solo el botón, grande y en el centro.
                    if !behavior-run: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 20px;
                        HorizontalLayout {
                            alignment: center;
                            ScanButton { size: 200px; busy: behavior-busy; progress: progress; clicked => { if (!behavior-busy) { scan-behavior(); } } }
                        }
                        if !behavior-busy: Text {
                            text: @tr("" => "Toca para revisar tu PC. Tarda unos segundos.");
                            font-size: 12px;
                            color: Theme.muted;
                            horizontal-alignment: center;
                        }
                    }

                    // Después: el botón se achica arriba y aparecen los resultados.
                    if behavior-run: VerticalLayout {
                        vertical-stretch: 1;
                        spacing: 12px;
                        HorizontalLayout {
                            spacing: 16px;
                            ScanButton { size: 80px; compact: true; busy: behavior-busy; clicked => { if (!behavior-busy) { scan-behavior(); } } }
                            VerticalLayout {
                                alignment: center;
                                spacing: 4px;
                                Text {
                                    text: behavior-busy ? progress : (findings.length == 0 ? @tr("" => "No encontré nada nuevo ni sospechoso en esta revisión. Eso no garantiza que la PC esté limpia.") : (findings.length == 1 ? @tr("" => "Encontré 1 cosa para revisar") : @tr("" => "Encontré {} cosas para revisar", findings.length)));
                                    font-size: 14px;
                                    color: Theme.text;
                                    wrap: word-wrap;
                                }
                                if sec-status != "": Text { text: I18n.t(sec-status); font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                            }
                        }
                        Scroll {
                            vertical-stretch: 1;
                            content-h: sec-cards.length * 80px + (threats.length > 0 ? 40px : 0px) + threats.length * 96px + findings-h;
                            VerticalLayout {
                                alignment: start;
                                spacing: 12px;
                                for f[i] in findings: FindingCard {
                                    title: f.title;
                                    detail: f.detail;
                                    decoded: f.decoded;
                                    severity: f.severity;
                                    can-disable: f.can-disable;
                                    can-restore: f.can-restore;
                                    ignore => { sec-confirm-action = 1; sec-confirm = i; }
                                    disable => { sec-confirm-action = 2; sec-confirm = i; }
                                    restore => { sec-confirm-action = 3; sec-confirm = i; }
                                }
                                for c in sec-cards: Info { icon: c.icon; title: c.title; sub: c.sub; }
                                if threats.length > 0: Label { text: @tr("" => "Detecciones registradas por Defender ({})", threats.length); }
                                for t in threats: Info { icon: t.icon; title: t.title; sub: t.sub; alert: t.alert; }
                            }
                        }
                    }
                }

// Sección con opciones: casillas con explicación y riesgo, y un solo botón principal.
                if page >= 10 && page <= 14: Page {
                    width: parent.width;
                    height: parent.height;
                    Head { title: I18n.t(sc-title); sub: I18n.t(sc-sub); }
                    if sc-loading: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: 10px;
                        Text { text: @tr("" => "Revisando tu PC…"); font-size: 14px; color: Theme.muted; horizontal-alignment: center; }
                        HorizontalLayout { alignment: center; Busy { width: 260px; } }
                    }
                    if !sc-loading: Scroll {
                        vertical-stretch: 1;
                        content-h: sc-h;
                        VerticalLayout {
                            alignment: start;
                            for r in sc-rows: Rectangle {
                                height: r.header ? 44px : 66px;
                                if r.header: Label { x: 4px; y: parent.height - 28px; height: 20px; text: I18n.t(r.title); }
                                if !r.header: Rectangle {
                                    height: 60px;
                                    border-radius: 8px;
                                    opacity: r.done ? 0.6 : 1.0;
                                    background: (sc-ta.has-hover && !r.done) ? Theme.chosen : Theme.raised;
                                    animate background { duration: 90ms; }
                                    sc-ta := TouchArea { enabled: !r.done; mouse-cursor: r.done ? MouseCursor.default : MouseCursor.pointer; clicked => { sc-toggle(r.idx); } }
                                    HorizontalLayout {
                                        spacing: 14px;
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        VerticalLayout { alignment: center; Check { checked: r.checked || r.done; radio: r.group > 0; } }
                                        if r.has-icon: VerticalLayout { alignment: center; AppIcon { size: 28px; img: r.icon; has-icon: true; initial: ""; } }
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            Text { text: I18n.t(r.title); font-size: 14px; color: Theme.text; overflow: elide; }
                                            Text { text: I18n.t(r.desc); font-size: 12px; color: Theme.muted; overflow: elide; }
                                        }
                                        if r.done: Text { text: @tr("" => "Aplicado"); font-size: 12px; color: Theme.faint; vertical-alignment: center; }
                                        if !r.done: VerticalLayout { alignment: center; RiskTag { risk: r.risk; } }
                                    }
                                }
                            }
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            if sc-result != "": Text { text: I18n.t(sc-result); font-size: 14px; color: Theme.accent; wrap: word-wrap; }
                            if sc-result == "": Text { text: sc-selected == 0 ? @tr("" => "No hay nada marcado.") : (sc-selected == 1 ? @tr("" => "1 marcada. Antes de aplicar te mostramos qué se va a hacer.") : @tr("" => "{} marcadas. Antes de aplicar te mostramos qué se va a hacer.", sc-selected)); font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                            if sc-more-count > 0: HorizontalLayout { alignment: start; TextLink { text: sc-more ? @tr("" => "Ocultar más opciones") : @tr("" => "Más opciones ({})", sc-more-count); clicked => { sc-more = !sc-more; sc-reload(); } } }
                        }
                        VerticalLayout { alignment: center; horizontal-stretch: 0; Btn { height: 38px; pad: 28px; font: 14px; strong: true; enabled: sc-selected > 0 && !sc-busy; text: I18n.t(sc-button); clicked => { sc-apply(); } } }
                    }
                }

                // Historial: todo lo que lumen cambió, con deshacer en cada cambio.
                if page == 15: Page {
                    width: parent.width;
                    height: parent.height;
                    Head { title: @tr("" => "Historial"); sub: @tr("" => "Todo lo que lumen cambió en tu PC. Cada cambio se puede deshacer."); }
                    if hist-status != "": Text { text: I18n.t(hist-status); font-size: 12px; color: Theme.accent; wrap: word-wrap; }
                    if hist.length == 0: VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        Text { text: @tr("" => "Todavía no hiciste ningún cambio con lumen."); font-size: 14px; color: Theme.muted; horizontal-alignment: center; }
                    }
                    if hist.length > 0: Scroll {
                        vertical-stretch: 1;
                        content-h: hist.length * 66px;
                        VerticalLayout {
                            alignment: start;
                            for h in hist: Rectangle {
                                height: 66px;
                                Rectangle {
                                    height: 60px;
                                    border-radius: 8px;
                                    background: Theme.raised;
                                    HorizontalLayout {
                                        spacing: 16px;
                                        padding-left: 16px;
                                        padding-right: 16px;
                                        VerticalLayout {
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            spacing: 2px;
                                            opacity: h.applied ? 1.0 : 0.5;
                                            Text { text: I18n.t(h.title); font-size: 14px; color: Theme.text; overflow: elide; }
                                            Text { text: I18n.t(h.detail); font-size: 12px; color: Theme.muted; overflow: elide; }
                                        }
                                        if !h.applied: Text { text: @tr("" => "Deshecho"); font-size: 12px; color: Theme.faint; vertical-alignment: center; }
                                        if h.applied && !h.undoable: Text { text: @tr("" => "No se puede deshacer"); font-size: 12px; color: Theme.faint; vertical-alignment: center; }
                                        if h.applied && h.undoable: VerticalLayout { alignment: center; Btn { height: 28px; text: @tr("" => "Deshacer"); clicked => { hist-undo(h.id); } } }
                                    }
                                }
                            }
                        }
                    }
                }

                if page == 9: Page {
                    width: parent.width;
                    height: parent.height;
                    Head { title: @tr("" => "Configuración"); sub: @tr("" => "Se guarda sola y se recuerda la próxima vez que abras lumen."); }
                    Rectangle {
                        height: 216px;
                        background: Theme.raised;
                        border-radius: 10px;
                        VerticalLayout {
                            ConfigRow {
                                title: @tr("" => "Tema");
                                desc: @tr("" => "Claro, oscuro o el mismo que usa Windows.");
                                Segmented { options: [@tr("" => "Automático"), @tr("" => "Claro"), @tr("" => "Oscuro")]; current: cfg-theme; picked(i) => { cfg-theme = i; config-changed(); } }
                            }
                            ConfigRow {
                                title: @tr("" => "Actualización del panel");
                                desc: @tr("" => "Cada cuánto se renuevan el uso del procesador, la memoria y la red.");
                                Segmented { options: [@tr("" => "1 segundo"), @tr("" => "2 segundos"), @tr("" => "5 segundos")]; current: cfg-refresh; picked(i) => { cfg-refresh = i; config-changed(); } }
                            }
                            ConfigRow {
                                last: true;
                                title: @tr("" => "Idioma");
                                desc: @tr("" => "El idioma de todos los textos de lumen.");
                                Segmented { options: ["Español", "English"]; current: cfg-lang; picked(i) => { cfg-lang = i; config-changed(); } }
                            }
                        }
                    }
                    Rectangle { vertical-stretch: 1; }
                    Text { text: @tr("" => "lumen {} · Licencia MIT · github.com/vitorinoluca/lumen", app-version); font-size: 12px; color: Theme.faint; }
                }
            }
        }
    }

    if confirm-app >= 0: Confirm {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        title: @tr("" => "¿Desinstalar {}?", confirm-app-name);
        body: @tr("" => "Se abre el desinstalador del programa. Cuando termine, te mostramos lo que haya quedado para que decidas si lo limpiás. Si lumen corre como administrador, antes se crea un punto de restauración.");
        ok-text: @tr("" => "Desinstalar");
        danger: true;
        ok => { uninstall(confirm-app); confirm-app = -1; }
        cancel => { confirm-app = -1; }
    }
    if kill-pid >= 0: Confirm {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        title: @tr("" => "¿Cerrar {}?", kill-name);
        body: @tr("" => "Perdés lo que no hayas guardado en ese programa. No se puede deshacer.");
        ok-text: @tr("" => "Cerrar proceso");
        danger: true;
        ok => { kill(kill-pid); kill-pid = -1; }
        cancel => { kill-pid = -1; }
    }
    if sec-confirm >= 0: Confirm {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        title: sec-confirm-action == 1 ? @tr("" => "¿Ignorar este hallazgo?") : (sec-confirm-action == 2 ? @tr("" => "¿Deshabilitar esto?") : @tr("" => "¿Restaurar lo que deshabilitó lumen?"));
        body: sec-confirm-action == 1 ? @tr("" => "Se agrega a la línea base y no se vuelve a mostrar. No cambia nada en tu PC.")
            : (sec-confirm-action == 2 ? @tr("" => "Se desactiva y antes se guarda un respaldo. Podés volver atrás con Restaurar. Algunos cambios necesitan abrir lumen como administrador.")
            : @tr("" => "Se vuelve a dejar como estaba antes de que lumen lo deshabilitara."));
        ok-text: sec-confirm-action == 1 ? @tr("" => "Ignorar") : (sec-confirm-action == 2 ? @tr("" => "Deshabilitar") : @tr("" => "Restaurar"));
        danger: sec-confirm-action == 2;
        ok => { finding-do(sec-confirm, sec-confirm-action); sec-confirm = -1; }
        cancel => { sec-confirm = -1; }
    }
    if sc-preview: PreviewDialog {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        rows: sc-preview-rows;
        rows-h: sc-preview-h;
        note: sc-preview-note;
        ok-text: sc-button;
        ok => { sc-preview = false; sc-run(); }
        cancel => { sc-preview = false; }
    }
    if opt-confirm: Confirm {
        x: 0;
        y: 0;
        width: root.width;
        height: root.height;
        title: @tr("" => "¿Aplicar las mejoras recomendadas?");
        body: @tr("" => "Se desactivan cosas que casi nadie necesita: anuncios, sugerencias, telemetría y servicios que casi no se usan. Se puede volver atrás desde acá, cambio por cambio. Algunos necesitan abrir lumen como administrador.");
        ok-text: @tr("" => "Aplicar");
        ok => { opt-confirm = false; apply-recommended(); }
        cancel => { opt-confirm = false; }
    }
}
